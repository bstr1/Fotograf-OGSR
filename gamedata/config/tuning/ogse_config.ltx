; Наcтройщик для мода OGSE Evolution v.0.6.9.3

[mass]
; Параметры ГГ:
; Максимально носимый вес
max_item_mass                              = 100


[inventory]
take_dist                                  = 300
max_weight                                 = 100 
max_ruck                                   = 56
max_belt                                   = 20
slots                                      = 10

slot_persistent_1                          = true     ;knife 0
slot_persistent_2                          = false    ;pistol 1
slot_persistent_3                          = false    ;automatic 2
slot_persistent_4                          = true     ;grenades 3
slot_persistent_5                          = true     ;binocular 4
slot_persistent_6                          = true     ;bolt 5
slot_persistent_7                          = false    ;outfit 6
slot_persistent_8                          = true     ;pda 7
slot_persistent_9                          = true     ;detector 8
slot_persistent_10                         = true     ;torch 9


; [custom_keyboard_action]
; quick_slot_1                             = kQUICK_SLOT_1
; quick_slot_2                             = kQUICK_SLOT_2
; quick_slot_3                             = kQUICK_SLOT_3
; quick_slot_4                             = kQUICK_SLOT_4
; swipe_mask                               = kSWIPE_MASK
; torch_switch                             = kHEADLAMP
; nvg_switch                               = kNIGHTVISION
; focus                                    = kFOCUS
; quicksave                                = kQUICK_SAVE
; quickload                                = kQUICK_LOAD
; watch                                    = kWATCH
; watch_mode                               = kWATCH_MODE
; biomap_switch                            = kBIOMAP_SWITCH
; slot_wheel                               = kRADIAL
; switch_mark                              = kSWITCH_MARK
; switch_mark_color                        = kSWITCH_MARK_COLOR


;Скриптовые параметры
[options]

;Включение/выключение рандомных тайников
option_random_treasure                     =1

;Частота выпадания тайников при выполненном condlist. Чем меньше, тем больше вероятность
treasure_dropout                           = 90

;Вывод содержимого нычки
treasure_need_text                         = 1

;Динамические новости и "некрологи", сообщения о монстрах
random_news                                = 1
random_news_delta                          = 5
spawn_message_flag                         = 2 ;сообщения о появившихся монстрах. 0 - выключены, 1 - сообшения только об очень опасных, 2 - сообщения об опасных и очень опасных, 3 - сообщения обо всех.
news_showtime                              = 5000 ;стандартное время показа сообщения (от 5000 до 20000)

;Периодичность выброса в игровых часах. К этому значению также добавляется случайная поправка от минус четырех до плюс четырёх часов. Указывайте значение только в целых числах не меньше 5.
t_surge                                    = 5

;Периодичность респауна монстров и людей в игровых часах. Если указать 0, то респаун будет происходить сразу, как только на локации освободится место для объектов. Указывайте только целые неотрицательные числа.
t_common                                   = 2

;Дополнительный спавн опасностей по окончанию Выброса. 1 - вкл., 0 - выкл.
additional_spawn                           = 0

;Таймер выброса на ЧАЭС в минутах реального времени.
aes_timer                                  = 5

;Множитель спавна аномалий. Не рекомендуется больше 4.0
spawn_anom_prob                            = 1

;Коэффициент вероятности попытки рождения артефакта аномалией в Выброс
spawn_blow_art_probe                       = 1

;эффект плохого самочувствия
bleed_enable                               = 0

;отравление аптечками
poison_drugs                               = 0

;медленное действие аптечки
slow_drugs                                 = 0

;эффекты попадания по главгерою 0 - выключено, 1 - сотрясения камеры без засветки при хедшоте, 2 - с засветкой
oh_shit_im_hit                             = 0

; тип погоды
weather_type                               = 1

; вероятность выпадения костюмов
suit_probability                           = 25
exo_probability                            = 15
s_time_factor                              = 5


[alife]
schedule_min                               = 1      ; milliseconds
schedule_max                               = 1      ; milliseconds
process_time                               = 900    ; microseconds
update_monster_factor                      = 0.1
time_factor                                = 5
normal_time_factor                         = 2      ; животные в оффлайне перемещаются со скоростью, делённой на этот фактор (чтобы не бегали очень быстро)
max_combat_iteration_count                 = 5      ; maximum combat iteration count
switch_distance                            = 160    ; metres
switch_factor                              = 0.1           
start_time                                 = 06:00:00 
start_date                                 = 15.10.2006
autosave_interval                          = 01:05:00
delay_autosave_interval                    = 00:00:30
objects_per_update                         = 10
start_game_callback                        = _G.start_game_callback  ; on starting new game or loading saved one
