[mounted_weapon]:
GroupControlSection                                = spawn_group
$spawn                                             = "weapons\mounted_weapon"
cform                                              = skeleton
class                                              = W_MOUNTD

flame_particles                                    = weapons\generic_weapon08
smoke_particles                                    = weapons\generic_weapon_riffle
shell_particles                                    = weapons\762x54l; weapons\generic_shells00

ammo_class                                         = ammo_vog-25

block_bore										   = true

fire_dispersion_base                               = 0.12
cam_relax_speed                                    = 5.0
cam_dispersion                                     = 0.2
cam_max_angle                                      = 8
cam_max_angle_horz                                 = 9.0
cam_step_angle_horz                                = 1.8
fire_dispersion_condition_factor                   = 5
misfire_probability                                = 0.005
condition_shot_dec                                 = 0.00001

hit_type                                           = fire_wound
fire_distance                                      = 3200
bullet_speed                                       = 825
rpm                                                = 400
shell_point                                        = 0.00, 0.0,0

visual                                             = dynamics\weapons\wpn_mounted\wpn_mounted_pkm_trenoga.ogf
light_color                                        = 0.9,0.9,0.5
light_range                                        = 7.0
light_var_color                                    = 0.1
light_var_range                                    = 0.7
light_time                                         = 0.07
light_disabled                                     = false

snd_close                             = weapons\draw_silent

[stationary_mgun]
GroupControlSection			= spawn_group
class						= W_STMGUN
$spawn						= "weapons\stationary_mgun"
cform   	                = skeleton
visual  	                = weapons\mounted_weapons\wpn_pkm_trenoga.ogf  

cam_relax_speed         	= 3.0		;скорость возврата в исходное положение
cam_dispersion          	= 0.0007		;увеличения угла (в градусах) с каждым выстрелом
cam_max_angle				= 1	    	;максимальный угол отдачи
snd_shoot					= weapons\weapon_heli
use_aim_bullet				= false

ammo_class					= ammo_btr
fire_dispersion_base		= 1.56
rpm            		        = 300
hit_power					= 10
hit_impulse					= 10
fire_distance  		        = 500
bullet_speed				= 500			;начальная скорость пули

light_color					= 0.9,0.9,0.5
light_range					= 6
light_var_color				= 0.05
light_var_range				= 0.5
light_time 					= 0.3

flame_particles				= weapons\generic_weapon_btr
smoke_particles				= weapons\generic_shoot_00
shell_point					= 0.0, 0.0, 0.0
shell_particles				= weapons\generic_shells00

tracer_trail_scale	 = 1.0
tracer_start_length	 = 1.0
tracer_width		 = 1.0

inv_name	        	= Mounted Weapon								; name in inventory	
inv_name_short			= Mounted Weapon

