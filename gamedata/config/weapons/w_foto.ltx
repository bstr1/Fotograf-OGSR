[wpn_foto]:identity_immunities
GroupControlSection	              = spawn_group
discovery_dependency              =
$spawn                            = "weapons\foto"	; option for Level Editor
$npc			 		          = on				; option for Level Editor
$prefetch 		 		          = 8
scheduled                         = off              	; option for ALife Simulator
cform                             = skeleton
class                             = WP_SVD
min_radius                        = 0
max_radius                        = 50

inv_show_condition                = false

ui_inv_descr.hide_description     = true

ef_main_weapon_type		          = 3
ef_weapon_type			          = 8

protected_item					  = true

CartridgeInTheChamberEnabled      = false

;-----------------------------------------------------------------------------------
holder_range_modifier	          = 2.85           ; во сколько раз увеличиваетс€ eye_range
holder_fov_modifier		          = 0.3              ; во сколько раз увеличиваетс€ eye_fov
;-----------------------------------------------------------------------------------

cost					          = 11050
weapon_class			          = sniper_rifle

ammo_limit				          = 60
ammo_current			          = 10
ammo_elapsed			          = 0

ammo_mag_size			          = 50
ammo_class				          = ammo_sd

sprint_allowed			          = true
;-----------------------------------------------------------------------------------
;базова€ дисперси€
fire_dispersion_base		      = 0.01 ;угол (в градусах) базовой дисперсии оружи€ (оружи€ зажатого в тисках)
control_inertion_factor		      = 1.0f

;отдача
cam_relax_speed         	      = 3;0.05	;скорость возврата в исходное положение
cam_dispersion          	      = 0.005	;увеличени€ угла (в градусах) с каждым выстрелом
cam_max_angle			          = 1.0	;максимальный угол отдачи
cam_max_angle_horz		          = 1.0	;(degree) maximum shot horizontal degree
cam_step_angle_horz		          = 0.05	;(degree) size of step camera moved in horizontal position while shooting

fire_dispersion_condition_factor  = 1	;увеличение дисперсии в процентах при максимальном износе
misfire_probability 		      = 0.000000001 ;веро€тность осечки при максимальном износе
misfire_condition_k			      = 0.0005
; condition_shot_dec 			  = 0.000000001 ;увеличение износа при каждом выстреле
condition_shot_dec 			      = 0
;-----------------------------------------------------------------------------------

hand_dependence 		          = 1
single_handed				      = 0

slot 					          = 1,2		; // secondary
animation_slot			          = 2		; type of the animation that will be used

inv_name				          = wpn_foto
inv_name_short			          = wpn_foto
description				          = wpn_foto_desc
script_binding          = bind_photo.init
inv_weight				          = 0.4

icon_group                        = 0
inv_grid_width                    = 2
inv_grid_height                   = 1
inv_grid_x                        = 20
inv_grid_y                        = 14

kill_msg_x			              = 166
kill_msg_y			              = 59
kill_msg_width		              = 82
kill_msg_height		              = 23

direction                         = 0, 0, 1

fire_point				          = 0.00,0.0,0.0
flame_particles                   = weapons\generic_weapon_gauss
shell_point		 		          = 0.00,0.0,0.0				; position (3rd person view) for shell to throw out
smoke_particles	 		          = weapons\generic_weapon_gauss	; name of the particles for shells
rpm_empty_click 		          = 120

; ttc
hit_power                         = 0 ; 0.10, 0.10, 0.10, 0.60
hit_impulse		 	              = 0 ; 300
hit_type 			              = fire_wound

fire_distance           	      = 0
bullet_speed		 	          = 15000	;начальна€ скорость пули
rpm                     	      = 30
; end ttc

