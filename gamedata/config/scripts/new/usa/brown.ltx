target = actor
snd = brown
meet = no_meet
danger = danger_condition@brown
on_signal = sound_end | walker@brown1

[walker@brown1]
path_walk = brown_walk
path_look = brown_look
meet = meet@brown
def_state_standing = ward
danger = danger_condition@brown

[danger_condition@brown]
ignore_distance = 10
ignore_distance_corpse = 0

[meet@brown]
use = true
use_wpn = false
meet_talk_enabled = true


