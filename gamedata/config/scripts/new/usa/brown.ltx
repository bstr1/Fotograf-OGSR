path_look = brown_look
meet = no_meet
def_state_standing = ward
danger = danger_condition@brown
on_actor_dist_le_nvis = 3 | {-brown_start_dialog_start} remark@brown, {+brown_start_dialog_start} walker@brown1

[remark@brown]
