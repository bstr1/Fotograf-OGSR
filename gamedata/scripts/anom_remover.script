local radius = 15
local radius_sqr = radius * radius

local ANOMALY_CLASS_NAMES = {
    -- статические зоны Z_
    "zone_acid_fog",
    "ameba_zone",
    "zone_bfuzz",
    "zone_dead",
    "zone_galantine",
    "zone_mosquito_bald",
    "zone_mincer",
    "nogravity_zone",
    "zone_radioactive",
    "zone_rusty_hair",
    "torrid_zone",
    -- AMK-аномалии
    "zone_bfuzz_s",
    "zone_electra_s",
    "zone_galant_s",
    "zone_ice_s",
    "zone_mbald_s",
    "zone_mincer_s",
    "zone_zharka_s",
}

local anomaly_clsids = {}
for _, name in ipairs(ANOMALY_CLASS_NAMES) do
    local id = clsid_table and clsid_table[name]
    if id then
        anomaly_clsids[id] = true
    end
end

local function is_anomaly(obj)
    return anomaly_clsids[obj:clsid()] == true
end

local function collect_anomalies(center, radius_sqr)
    local result = {}
    local object_by_id = level.object_by_id

    for id = 1, 65534 do
        local obj = object_by_id(id)
        if obj and is_anomaly(obj) and center:distance_to_sqr(obj:position()) < radius_sqr then
            result[#result + 1] = obj
        end
    end

    return result
end

function on_item_drop(item)
    if not item or item:section() ~= "anom_remover" then
        return
    end

    local actor = db.actor
    if not actor then
        return
    end

    for _, obj in ipairs(collect_anomalies(actor:position(), radius_sqr)) do
        obj:disable_anomaly()
    end
end
