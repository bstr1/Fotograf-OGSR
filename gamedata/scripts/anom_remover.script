local radius = 100 --радиус круга с центром под ногами ГГ, в котором отключаются аномалии

-- у телепортов и костров class = Z_MBALD, т.е. is_anomaly() их тоже цепляет,
-- а отключать их не надо
local excluded_sections = {
    zone_teleport         = true,
    zone_teleport_out     = true,
    zone_teleport_monolith = true,
}

local function is_excluded(sect)
    if excluded_sections[sect] then return true end
    if string.find(sect, "teleport", 1, true) then return true end
    if string.find(sect, "campfire", 1, true) then return true end
    if string.find(sect, "kampfire", 1, true) then return true end
    if string.find(sect, "_tp",      1, true) then return true end -- c_tp1, c_tp1b ...
    return false
end

function get_anoms(npc, r)
    local anoms = {}
    local pos = npc:position()
    local r2 = r * r
    for i = 1, 65534 do
        local obj = level.object_by_id(i) -- только онлайн-объекты
        if obj and obj:is_anomaly() and not is_excluded(obj:section()) then
            if pos:distance_to_sqr(obj:position()) < r2 then
                anoms[#anoms + 1] = obj
            end
        end
    end
    return anoms
end

function on_item_drop(item)
    if item:section() ~= "anom_remover" then return end

    local anoms = get_anoms(db.actor, radius)
    if #anoms == 0 then return end
    --amk.mylog("anom_remover: disabled "..#anoms.." anomalies")

    for _, obj in ipairs(anoms) do
        -- pcall: для не-зоны disable_anomaly() может бросить/уронить
        pcall(function() obj:disable_anomaly() end)
    end
end