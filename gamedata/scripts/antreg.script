function start_antreg()
    if level.name() == "dead_city" then


    elseif level.name() == "l08u_brainlab" and not has_alife_info("yan_labx16_switcher_primary_new") then
        db.actor:give_info_portion("yan_labx16_switcher_primary_new")

    elseif level.name() == "predbannik" and has_alife_info("voronin_zapiska_dialog_done") and
        not has_alife_info("barman_strelka_pogovority") then
        db.actor:give_info_portion("barman_strelka_pogovority")

    elseif level.name() == "predbannik" and has_alife_info("voronin_zapiska_dialog_done") and
        not has_alife_info("wolki_mk_spawn") then
        db.actor:give_info_portion("wolki_mk_spawn")

    elseif level.name() == "dead_city" and has_alife_info("karina_poisk_dialog_start") and
        not has_alife_info("dogs_perehod") then
        db.actor:give_info_portion("dogs_perehod")

    elseif level.name() == "l05_bar" and not has_alife_info("totaliz_mos") then
        db.actor:give_info_portion("totaliz_mos")

    elseif level.name() == "predbannik" and not has_alife_info("usa_spawn") then
        db.actor:give_info_portion("usa_spawn")

    elseif level.name() == "swamp" and not has_alife_info("boloto_start") then
        db.actor:give_info_portion("boloto_start")

    elseif level.name() == "swamp" and not has_alife_info("boloto_zadan") then
        db.actor:give_info_portion("boloto_zadan")

    elseif level.name() == "swamp" and has_alife_info("doctor_enemy") and not has_alife_info("enemy_doctor") then
        db.actor:give_info_portion("enemy_doctor")

    elseif level.name() == "l04u_labx18" and not has_alife_info("elchimera_start") then
        db.actor:give_info_portion("elchimera_start")

    end
end

