--[[
-- 	Заспавнить предмет в инвентарь к актору.
-- 	@param     	string           sItemSection     	Секция предмета который нужно заспавнить.
--]]
function amkCreateItemActor(s)
	return got_item(s)
end

function amkDelObj(i)
	release(i)
end	



--[[
--	amkEnableDevice()
--	Включить девайс...
--	@param	integer	iLevelDevice	Уровень девайса. (нужно для апгрейда)
--]]
function amkEnableDevice(iLevelDevice)
	if oDevice or db.actor==nil or db.actor:alive()~=true then return end
	amkCreateItemActor("amk_transmutator")
	
	aArtsInfo = {}
	aRecsInfo = {}
	aRecSections = {}
	aArtsInventory = {}
	aKompCrystal = {}
	aInterval = {1,6}
	aRecInterval = {1,4}	
	-- трансмутатор работает в пси-зонах prom_kat_/aver_kat_, а не в аномалиях
	aZoneNum = nil
	aAnomaly, aAnomId = get_trans_zone()
	if aAnomaly then
		aZoneNum = get_zone_num(aAnomId)
	end
	init_crystal_data(aZoneNum)
	-- если стоим в пси-зоне, заполняем таблицу с рецептами
	if aAnomaly and aAnomId and amk.has_timer('off_zone'..aAnomId) then
		-- пси-зона погашена после варки: рецептов нет, прибор показывает только статус
		anomaly_name = zone_display_name().." - погашена"
		aRecipts = nil
	elseif aAnomaly then
		aRecipts,anomaly_name = known_recipes(), zone_display_name()
		aReciptsHave = {}
		for info, recept in pairs(aRecipts) do
			for sect, v in pairs(recept["komp"]) do
				aKompCrystal[sect] = true
			end
		end
		if type(aRecipts)=="table" then
			for info, recept in pairs(aRecipts) do
				if type(recept) == "table" then -- берём только открытые рецепты
					aReciptsHave[info] = {}
					for k, v in pairs(recept) do -- копируем рецепт
						if type(v) == "table" then
							aReciptsHave[info][k] = {}
							for i, j in pairs(v) do
								aReciptsHave[info][k][i] = j
							end
						else
							aReciptsHave[info][k] = v
						end
						if k == "cel" then
							for m, n in pairs(v) do
								local uje_est = false
								for i=1, table.getn(aRecSections) do
									if aRecSections[i] == m then
										uje_est = true
									end
								end
								if not uje_est then
									table.insert(aRecSections,m)								
								end
								-- break
							end
						end
					end
				end
			end
		end
	end
	CAmkMergerArtefact()
	oDevice = CAmkDeviceTransmutator(iLevelDevice)
	level.start_stop_menu(oDevice, true)
end

--[[
--	amkDisableDevice()
--	Выключить девайс...
--]]
function amkDisableDevice()	
	if oNotkomp then oDevice:DetachChild(oNotkomp) end
	oDevice	= nil
	aArtsInfo  = nil
	aRecsInfo = nil
	aRecSections = nil
	aArtsInventory 	= nil
	aInterval = nil
	aRecInterval = nil
	aAnomaly = nil
	aAnomId = nil
	aZoneNum = nil
	iInfo = nil
	aReciptsHave = nil
	aRecipts = nil
	oNotkomp = nil
	for k,tbl in pairs(aScrollBar) do
		tbl.oSlot = nil
		tbl.iSectIndex = nil
	end
	for k,tbl in pairs(aCmpnSlots) do
		tbl.oSlot = nil
		tbl.iSectIndex = nil
	end
	for k,tbl in pairs(aRecBar) do
		tbl.oSlot = nil
		tbl.iSectIndex = nil
	end
end

function amkUseTransmutator(oItem)
	if oItem:section() == "amk_transmutator" then 
		amkEnableDevice()
	end
end

function get_anom_name(str)
	local s_name
	if anomaly_name	~= nil then
		s_name = anomaly_name
	else
		s_name = "Неизвестно"
	end
	return s_name
end

