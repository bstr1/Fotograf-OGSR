	self.iLevelDevice = iLevelDevice
	self:InitInterface()	
	self:UpdScrollBar(aInterval[1], aInterval[2], "Inv")
	self:UpdScrollBar(aRecInterval[1], aRecInterval[2], "Rec")
end

function CAmkDeviceTransmutator:__finalize() 
end

