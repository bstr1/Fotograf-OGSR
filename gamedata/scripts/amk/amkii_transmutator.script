local aReciptsHave = nil	-- table имеющиеся у ГГ рецепты для аномалии
local aRecsInfo = nil		-- table данные результатов варки для рецептного скролла
local aRecSections = nil	-- table список секций артов в рецептном скролле
local aAnomId = nil			-- integer id аномалии вблизи
local aZoneNum = nil		-- integer группа рецептов (zone_kat_NN) текущей пси-зоны
local iInfo = nil			-- string название инфопоршня рецепта

--[[
--	Префиксы имён пси-зон, в которых работает трансмутатор (зоны кристаллов ex_transform).
--]]
local aTransZones = {
	"aver_kat_", "bar_kat_", "deadcity_kat_", "dyshlo_kat_",
	"hr_kat_", "mk_kat_", "pripyat_kat_", "prom_kat_", "swamp_kat_"
}

--[[
--	get_zone_num(iAnomId)
--	Номер группы рецептов (zone_kat_NN), к которой привязана пси-зона.
--	Берётся из custom_data рестриктора: этот же номер logic-конфиг зоны передаёт
--	в ex_transform.zone_wel/zone_act/zone_trans, поэтому прибор и сама аномалия
--	всегда работают с одним и тем же набором рецептов.
--]]
function get_zone_num(iAnomId)
	if not iAnomId then return nil end
	local sobj = alife():object(iAnomId)
	local cd = sobj and sobj.custom_data or ""
	return tonumber(string.match(cd, "zone_kat_(%d+)"))
end

--[[
--	get_trans_zone()
--	Поиск пси-зоны трансмутации, внутри которой сейчас стоит актор.
--]]
function get_trans_zone()
	local actor = db.actor
	if actor == nil then return nil end
	local pos = actor:position()
	for name, obj in pairs(db.zone_by_name) do
		for i = 1, table.getn(aTransZones) do
			if name and string.sub(name, 1, string.len(aTransZones[i])) == aTransZones[i] then
				if obj and obj:inside(pos) then
					return name, obj:id()
				end
			end
		end
	end
	return nil
end

--[[
--	Кристальные рецепты прибора. Строятся из transform_data (ex_transform.script),
--	формат как у AMK-рецептов: komp/cel.
--	Ключ рецепта - инфопоршень ex_transform_rec_<результат> (записывается в ПДА при варке).
--	Варка мгновенная и всегда удачная: ни времени, ни шанса нет.
--	Загружается только группа рецептов текущей пси-зоны (zone_kat_NN), см. init_crystal_data(zoneNum).
--]]
local aReciptsCrystal = nil
local aKompCrystal = nil
local aCrystalZone = nil	-- integer группа рецептов, для которой построен aReciptsCrystal

function init_crystal_data(zoneNum)
	if aReciptsCrystal and aCrystalZone == zoneNum then return end
	aCrystalZone = zoneNum
	aReciptsCrystal = {}
	local td = ex_transform.get_transform_recipes()
	if type(td) ~= "table" then
		return
	end
	-- в конкретной пси-зоне работают только рецепты её группы, остальное варить нельзя
	local group = zoneNum and td[zoneNum] or nil
	if type(group) ~= "table" then
		return
	end
	for i = 1, table.getn(group) do
		local rec = group[i]
		if type(rec) == "table" and table.getn(rec) >= 3 then
			local result = rec[table.getn(rec)]
			local info = "ex_transform_rec_"..result
			if aReciptsCrystal[info] == nil then
				local komp = {}
				for c = 1, table.getn(rec) - 1 do
					komp[rec[c]] = true
				end
				aReciptsCrystal[info] = {komp = komp, cel = {[result] = true}}
			end
		end
	end
end

--[[
--	Имя пси-зоны для шапки прибора: тип зоны определяется группой рецептов (zone_kat_NN).
--]]
function zone_display_name()
	local base = "Зона трансмутации"
	if not aZoneNum then
		if aAnomaly then return base.." (рецепт не опознан)" end
		return base
	end
	if aZoneNum <= 4 then return base.." - Абсолютов №"..aZoneNum
	elseif aZoneNum <= 6 then return base.." - Талисманов №"..(aZoneNum - 4)
	else return base.." - Оберегов №"..(aZoneNum - 6) end
end
--[[
--	known_recipes()
--	Рецепты текущей пси-зоны, которые ГГ уже открыл: поршень ex_transform_rec_<результат>
--	выдаётся, когда артефакт впервые сварен руками в аномалии. Пока рецепт не открыт,
--	в приборе его нет: ни в списке рецептов, ни в поиске схемы для ручной сборки.
--]]
function known_recipes()
	local known = {}
	if type(aReciptsCrystal) ~= "table" or db.actor == nil then return known end
	for info, recept in pairs(aReciptsCrystal) do
		if db.actor:has_info(info) then
			known[info] = recept
		end
	end
	return known
end


