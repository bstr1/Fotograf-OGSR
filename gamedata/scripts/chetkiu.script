function give_govno(first_speaker, second_speaker)
    dialogs.relocate_item_section(second_speaker, "mutant_flesh_eye", "in", 1)
    dialogs.relocate_item_section(second_speaker, "vypolzen_hrebet", "in", 1)
    dialogs.relocate_item_section(second_speaker, "ks_talisman_06", "in", 1)
end


local deal_phase = 0
function sms_verka()
    news_manager.send_tip(db.actor, "zapadlo_sms_" .. deal_phase)

    if deal_phase >= 4 then
        db.actor:give_info_portion("haron_dialog_sms")
        boryan67.verka_spawn()
    else
        dsh.start_timer("haron_timer", 10, "chetkiu.sms_verka")
    end

    deal_phase = deal_phase + 1
end


function broken_exo()
    ogse.spawn_item_in_inv("broken_exoskeleton")
end


function dez_mask_teleport(first_speaker, second_speaker)
    dsh.wait_condition(function() return db.actor:dont_has_info("ui_talk") end, function()
        level.add_pp_effector("black.ppe", 2006, false)
        dsh.timeout(1000, function()
            local sim = alife()
            local pos = patrol("dez_mask1_walk")
            local last = pos:count() - 1
            for a = 1, 65534 do
                local sobj = sim:object(a)
                if sobj and sobj:section_name() == "dez_mask" then
                    sim:teleport_object(a, pos:point(last), pos:level_vertex_id(last), pos:game_vertex_id(last))
                    break
                end
            end
            db.actor:set_actor_position(pos:point(last))
        end)
    end)
end


