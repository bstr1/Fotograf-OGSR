function verka_teleport(first_speaker, second_speaker)
    dsh.wait_condition(function() return db.actor:dont_has_info("ui_talk") end, function()
        level.add_pp_effector("black.ppe", 2006, false)
        dsh.timeout(1000, function()
            local sim = alife()
            local pos = patrol("verka1_walk")
            local last = pos:count() - 1
            for a = 1, 65534 do
                local sobj = sim:object(a)
                if sobj and sobj:section_name() == "verka" then
                    sim:teleport_object(a, pos:point(last), pos:level_vertex_id(last), pos:game_vertex_id(last))
                    break
                end
            end
            local actor_pos = vector():set(-294.42, 9.68, -171.28)
            local look_dir = vector():set(-0.98, -0.09, -0.14)
            db.actor:set_actor_position(actor_pos)
            db.actor:set_actor_direction(-look_dir:getH())
        end)
    end)
end


