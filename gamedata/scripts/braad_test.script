local nepis = {}
local nepis_id = {}
local dead_npc_count = 0

function dead_npc()
    if dead_npc_count < time_global() then
        for a = 1, table.getn(nepis), 1 do
            local npis = nepis[a]
            local obj = alife():story_object(npis)
            if obj and IsStalker(obj) and not obj:alive() then
                local name = obj:name()
                if not has_alife_info(name .. "_umer") then
                    db.actor:give_info_portion(name .. "_umer")
                end
            end
        end
        dead_npc_count = time_global() + 5500
    end
    if level.name() == "l11_pripyat" and has_alife_info("prizrak_help_have") and not has_alife_info("haron_sms") then
        amk.start_timer("sms_new", math.random(100, 120))
        db.actor:give_info_portion("haron_sms")
    elseif level.name() == "l12_stancia" and has_alife_info("prizrak_kill_start") and not has_alife_info("doctor_sms") then
        amk.start_timer("sms_doc", math.random(10, 20))
        db.actor:give_info_portion("doctor_sms")

    elseif level.name() == "l07_military" and not has_alife_info("actor_na_scladah") then
        db.actor:give_info_portion("actor_na_scladah")
    elseif level.name() == "l03_agroprom" and not has_alife_info("actor_na_agro") then
        db.actor:give_info_portion("actor_na_agro")
    elseif level.name() == "l10_radar" and not has_alife_info("actor_na_radare") then
        db.actor:give_info_portion("actor_na_radare")
