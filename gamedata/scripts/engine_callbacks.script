local fx_files = {
    ["fx_blowout_day"] = nil,
    ["fx_blowout_night"] = nil
}

function on_change_weather(sect)
    local w = level.get_weather()
    if fx_files[w] == nil then return end

    local ini = fx_files[w]
    if not ini then
        ini = ini_file("environment\\weather_effects\\" .. w .. ".ltx")
        fx_files[w] = ini
    end

    if not ini:section_exist(sect) or not ini:line_exist(sect, "give_info") then return end
    if not (db.actor and db.actor:alive()) then return end

    local id = ini:r_string(sect, "give_info")
    db.actor:disable_info_portion(id)
    db.actor:give_info_portion(id)
end
