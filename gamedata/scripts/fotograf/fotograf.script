function metka_foto(sect, type, text)
    local id, sobj
    for a = 1, 65535 do
        sobj = alife():object(a)
        id = sobj and sobj:section_name() == sect and sobj.id
        if id then
            amk.add_spot_on_map(id, "crlc_foto", text)
            return
        end
    end
end

function del_metka_foto(sect, type)
    local id, sobj
    for a = 1, 65535 do
        sobj = alife():object(a)
        id = sobj and sobj:section_name() == sect and sobj.id
        if id then
            level.map_remove_object_spot(id, "crlc_foto")
            break
        end
    end
end

