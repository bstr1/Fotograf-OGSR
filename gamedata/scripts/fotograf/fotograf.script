function levsha_bar_have(task, info)
    if not db.actor then
        return false
    end
    if db.actor:has_info("bar_ataka_01_mesto") then

        local bpos = db.actor:position()
        for a = 1, 65535 do
            local obj = level.object_by_id(a)
            if obj and obj:id() ~= db.actor:id() then
                if IsMonster(obj) then
                    local dist = obj:position():distance_to(bpos)
                    if dist < 150 then
                        local h = hit()
                        h.draftsman = obj
                        h.direction = vector():set(0, 0, 0)
                        h:bone("bip01_spine")
                        h.type = hit.explosion
                        h.power = 10
                        h.impulse = 100
                        obj:hit(h)
                    end
                end
            end
        end

        return db.actor:give_info_portion("levsha_start_dialog_have")
    end
    return false
end

