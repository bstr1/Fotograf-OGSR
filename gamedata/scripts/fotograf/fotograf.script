----------------------------------Фотографирование----------------------------

local last_load = 0

function camera_update()
    local foto = db.actor:object("wpn_foto")
    if foto and not has_alife_info("fotik_take_first") then
        foto:unload_magazine()
        db.actor:give_info_portion("fotik_take_first")
    end
    local wpn = db.actor:item_in_slot(db.actor:active_slot())
    if wpn and wpn:section() == "wpn_foto" then
        local load = wpn:get_ammo_in_magazine()
        if load < last_load then
            if db.actor:has_info("mozhno_delat_foto") then
                db.actor:give_info_portion("foto_sdelal")
            end
        end
        last_load = load
    end
end

function camera1_update()
    local foto = db.actor:object("wpn_foto1")
    if foto and not has_alife_info("fotik1_take_first") then
        foto:unload_magazine()
        db.actor:give_info_portion("fotik1_take_first")
    end
    local wpn = db.actor:item_in_slot(db.actor:active_slot())
    if wpn and wpn:section() == "wpn_foto1" then
        local load = wpn:get_ammo_in_magazine()
        if load < last_load then
            if db.actor:has_info("mozhno_delat_foto") then
                db.actor:give_info_portion("foto_sdelal")
            end
        end
        last_load = load
    end
end

