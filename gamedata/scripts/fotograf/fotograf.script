        db.actor:has_info("naem_dyshlo_03_dead") and db.actor:has_info("naem_dyshlo_04_dead") and
        db.actor:has_info("naem_dyshlo_05_dead") and db.actor:has_info("naem_dyshlo_06_dead") and
        db.actor:has_info("naem_dyshlo_07_dead") and db.actor:has_info("naem_dyshlo_08_dead") and
        db.actor:has_info("naem_dyshlo_09_dead") and db.actor:has_info("naem_dyshlo_10_dead") and
        db.actor:has_info("naem_dyshlo_11_dead") and db.actor:has_info("naem_dyshlo_12_dead") and
        db.actor:has_info("naem_dyshlo_13_dead") and db.actor:has_info("naem_dyshlo_14_dead") and
        db.actor:has_info("naem_dyshlo_15_dead") and db.actor:has_info("naem_dyshlo_16_dead") and
