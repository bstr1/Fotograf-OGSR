                if has_alife_info("ex_transform_rec_ks_talisman_04") or
                    has_alife_info("ex_transform_rec_ks_talisman_05") or
                    has_alife_info("ex_transform_rec_ks_talisman_06") then
                    db.actor:give_info_portion("recept_two_est")
                end
            end
        end

        if has_alife_info("sbor_recepts_og_start") and not has_alife_info("recept_tri_est") then
            if has_alife_info("ex_transform_rec_ks_obereg_01") or has_alife_info("ex_transform_rec_ks_obereg_02") or
