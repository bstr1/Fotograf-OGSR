-----------------------------lukash_boom-----------------------------

function spawn_pda_boom()
    local sobj = alife():create("bomba", vector():set(-50.112, 3.540, 261.312), 108130, 905)
    if sobj then
        amk.save_variable("bomb", sobj.id) -- pstor хранит только число/строку/логическое - таблицу в pstor не сохранить
    end
end

function lukash_boom()
    local bpos, dist, obj
    local bomb = amk.load_variable("bomb")
    if bomb == nil then
        return
    end -- зона bomba_restr зовёт без условий, бомба может быть ещё не заспавнена
    local id
    if type(bomb) == "number" then
        id = bomb
    else
        for k, v in pairs(bomb) do
            id = k
        end -- старый формат из сейвов 1.0004: таблица {[id]=имя}
    end
    if id == nil then
        return
    end
    local sobj = alife():object(id)
    local bobj = level.object_by_id(id)
    if bobj then
        bpos = bobj:position()
    elseif sobj then
        bpos = vector():set(sobj.position.x, sobj.position.y, sobj.position.z) -- клиентский объект оффлайн - берём координаты с серверного
    end
    if bpos == nil then
        return
    end
    if sobj then
        alife():release(sobj)
    end
    amk.del_variable("bomb")
    amk_particle.amk_particle({
        particle = "explosions\\explosion_fuelcan",
        pos = bpos,
        sound = [[weapons\t_rgd5_explosion]]
    })

    for a = 1, 65535 do
        obj = level.object_by_id(a)
        if obj then
            if IsMonster(obj) or IsStalker(obj) then
                dist = obj:position():distance_to(bpos)
                if dist < 50 then
                    local h = hit()
                    h.draftsman = obj
                    h.direction = vector():set(0, 0, 0)
                    h:bone("bip01_spine")
                    h.type = hit.explosion
                    h.power = 10
                    h.impulse = 100
                    obj:hit(h)
                    if obj:id() == db.actor:id() then
                        level.add_pp_effector("amk_shoot.ppe", 2011, false)
                    end
                end
            end
        end
    end
end

