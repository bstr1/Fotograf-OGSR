------------Убивание наёмников на фабрике в Червоне Дышло------------

function kill_dyshlo_killers(first_speaker, second_speaker)
    if not alife() then
        return
    end
    local sobj
    for a = 1, 65535 do
        sobj = alife():object(a)
        if sobj and string.find(sobj:name(), "naemnik_") then
            alife():release(sobj, true)
        end
    end
end

