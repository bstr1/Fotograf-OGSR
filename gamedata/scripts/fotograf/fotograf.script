function pivo_zhorik_net(first_speaker, second_speaker)
    return db.actor and not db.actor:object("old_melnik") and not db.actor:object("chernigov")
end

function drink_zhorik_pivo(first_speaker, second_speaker)
    local buhnul = false
    if db.actor then
        -- проверяем наличие пива у актёра
        local has_melnik, has_chernigov = has_drink()
        -- old_melnik предпочтительней
        if has_melnik then
            db.actor:eat(db.actor:object("old_melnik"))
            return true
        end
        -- если old_melnik нет, то пьём chernigov
        if has_chernigov then
            db.actor:eat(db.actor:object("chernigov"))
            buhnul = true
        end
    end
    return buhnul
end

function has_drink()
    local item, has_melnik, has_chernigov, sect
    local count = db.actor:object_count()
    for i = 1, count do
        item = db.actor:object(i)
        sect = item and item:section()
        if sect then
            if sect == "old_melnik" then
                has_melnik = true
                return has_melnik, has_chernigov
            elseif sect == "chernigov" then
                has_chernigov = true
            end
        end
    end
    return has_melnik, has_chernigov
end

function havchik_have()
    return new_dialog.count_item("vodka", 2) and new_dialog.count_item("sguschenka", 1) and new_dialog.count_item("gribki", 1) and new_dialog.count_item("ogirki", 1)
