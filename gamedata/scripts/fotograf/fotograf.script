local function distance_check()
    if not has_alife_info("zhorik_start") or not has_alife_info("agent_mk_spawn") or has_alife_info("agent_mk_vrag") then return end
    local mk_agent = level_object_by_sid(story_ids.mk_agent)
    if mk_agent and distance_between(mk_agent, db.actor) < 45 then
        db.actor:give_info_portion("agent_mk_vrag")
    end
end

function attach(sm)
    sm:subscribe({signal = "on_update",         fun = distance_check})
    sm:subscribe({signal = "on_take",          fun = on_take})
end