-- проверка на наличие прибора
function has_anom_pribor()
    return db.actor and not db.actor:object("anom_pribor")
end

-- проверка на отсутствие прибора
function not_anom_pribor()
    return db.actor and not db.actor:object("anom_pribor")
end

-- проверка на наличие зондов
function has_zond()
    return db.actor and not db.actor:object("anom_zond") and db.actor:object("anom_pribor")
end

-- проверка на отсутствие зондов
function not_zond()
    return db.actor and not db.actor:object("anom_zond") and db.actor:object("anom_pribor")
end

function dell_GG_zond()
    local id, item, sect, sobj
    local count = db.actor:object_count()
    for i = 0, count - 1 do
        item = db.actor:object(i)
        sect = item and item:section()
        if sect and sect == 'anom_zond' then
            id = (item:id() or item.id)
            sobj = id and alife():object(id)
            if sobj then
                alife():release(sobj, true)
            end
        end
    end
end

