        if (has_alife_info("plichko_dead") or has_alife_info("drozdov_dead") or has_alife_info("dolg_mask6_dead")) and
            not has_alife_info("dolg_ataka_have") and not has_alife_info("dolg_ataka_proval") then
            db.actor:give_info_portion("dolg_ataka_proval")

        elseif has_alife_info("dolg_ataka_finish") and has_alife_info("blowout_end") and
            not has_alife_info("blowout_end_dyshlo") then
            db.actor:give_info_portion("blowout_end_dyshlo")

        elseif has_alife_info("maroder_prom_01_dead") and has_alife_info("maroder_prom_02_dead") and
