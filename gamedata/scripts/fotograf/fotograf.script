local function on_take(obj, sobj)
    if obj:section() == "af_perdonit" and db.actor:has_info("perdonit_enable") and not db.actor:has_info("perdonit_taken") then
        db.actor:give_info_portion("perdonit_taken")

        alife():create("m_controller_senator", vector():set(340.53, -6.32, -14.55), 1474965, 790)
        alife():create("m_controller_senator1", vector():set(335.71, -2.08, 10.23), 1467098, 790)
        alife():create("m_controller_senator2", vector():set(291.31, -3.62, -36.31), 1385034, 790)
        level.add_pp_effector("black.ppe", 2006, false)
        local snd_obj = xr_sound.get_safe_sound_object([[zwuk\controller_evil]])
        snd_obj:play(db.actor, 0, sound_object.s2d)

    elseif obj:section() == "wpn_coltm45a1" and db.actor:dont_has_info("smith_razgovor_start") then
        db.actor:give_info_portion("smith_razgovor_start")
    elseif obj:section() == "wpn_foto" and db.actor:dont_has_info("fotik_nashel") then
        db.actor:give_info_portion("fotik_nashel")
    elseif obj:section() == "wpn_vintorez" or obj:section() == "wpn_vintorez_nimble" and db.actor:dont_has_info("about_vintorez") then
        db.actor:give_info_portion("about_vintorez")

    elseif obj:section() == "maloy_pda" and db.actor:dont_has_info("maloy_pda_est") then
        db.actor:give_info_portion("maloy_pda_est")
    elseif obj:section() == "money2" then
