            level.add_pp_effector("yantar_underground_psi.ppe", 2007, false)
            level.add_pp_effector("teleport.ppe", 65015, false)
            local snd_obj = xr_sound.get_safe_sound_object([[forest\new\mandra]])
            break
        end
    end
end

