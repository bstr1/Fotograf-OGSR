local max_strings = 100  -- Максимальное количество строк


function attach( sm )
  sm:subscribe({ signal = "on_use",  fun = this.on_use })
  sm:subscribe({ signal = "on_rukzak_use", fun = this.on_rukzak_use })
  sm:subscribe({ signal = "on_body_open", fun = this.body_open  })
  sm:subscribe({ signal = "on_body_hide", fun = this.body_close })
end


function on_use( obj, sobj )
  local sect = obj:section()
  if sect == "treasure_item" then
    spawn_magic_rukzak( sect )
    level.start_stop_menu( level.main_input_receiver(), true )
    return true
  end
end


function spawn_magic_rukzak( sect, map )
  local real = get_string( sect, "real_item_section" )
  local pos  = db.actor:position()
  local new  = create(
    real, pos, db.actor:level_vertex_id(), db.actor:game_vertex_id()
  )
  local sobj = alife():object( new.id )
  sobj:used_ai_locations( false )
  if map then
    map_adds( sobj.id, "habar_location", map )
  end
end


local flag_use = false
local active_ui_rukzak = false
local inv_open_snd = sound_object( "interface\\inv_open" )

function on_rukzak_use( obj )
  -- db.actor:hide_weapon()
  -- bind_stalker.hide_weapon()
  inv_open_snd:play( db.actor, 0, sound_object.s2d )
  active_ui_rukzak = ui_rukzak( obj:id() )
  level.start_stop_menu( active_ui_rukzak, true )
  flag_use = true
end


function possible_inv_change()
  if active_ui_rukzak then
    active_ui_rukzak:full_reload()
  end
end


local game_types_cache = {}

function override_game_type( sect )
  if not game_types_cache[ sect ] then
    local gtype = get_string( sect, "dsh_rukzak.override_game_type" )
    if gtype then
      gtype = gtype == "other" and "" or gtype
    elseif string.find( sect, "fake_wpn_", 1, true ) then
      gtype = "knife"
    elseif
      string.find( sect, "mutant_", 1, true )
      or get_bool( sect, "monster_part", false )
    then
      gtype = "mutant_part"
    elseif string.find( sect, "arc_art_box_", 1, true ) then
      gtype = "artefact"
    elseif
      string.find( sect, "bomba" )
      or string.find( sect, "detonator" )
      or string.find( sect, "detector" )
      or string.find( sect, "teleporter" )
      or string.find( sect, "wpn_binoc", 1, true )
      or string.find( sect, "ogg_flash_", 1, true )
      or spawn_level_changer.teleports[ sect ]
    then
      gtype = ""
    end
    if gtype then game_types_cache[ sect ] = gtype end
  end
  return game_types_cache[ sect ]
end


function load_rukzak( id )
  local prefix     = "dsh_rukzak." .. id
  local conds      = ogse.load_var_safe( prefix .. ".conds"     ) or {}
  local counts     = ogse.load_var_safe( prefix .. ".counts"    ) or {}
  local game_types = ogse.load_var_safe( prefix .. ".types"     ) or {}
  local infos      = ogse.load_var_safe( prefix .. ".infos"     ) or {}
  local sections   = ogse.load_var_safe( prefix .. ".sections"  ) or {}
  local all_types  = ogse.load_var_safe( prefix .. ".all_types" )
  local type_names = {}
  if all_types then
    for i, gt in ipairs( all_types ) do
      type_names[ i ] = gt
    end
  end
  local data, index = {}, {}
  for i, sect in ipairs( sections ) do
    local gt = game_types[ i ]
    if all_types then
      gt = type_names[ gt ]
    end
    local cond = tonumber( conds[ i ] )
    local info = infos[ i ] or ""
    local key  = sect .. ":" .. string.format( "%.2f", cond ) .. ":" .. info
    local item = {
      [ "section"   ] = sect,
      [ "condition" ] = tonumber( string.format( "%.2f", cond ) ),
      [ "game_type" ] = ( override_game_type( sect ) or gt ),
      [ "count"     ] = tonumber( counts[ i ] ),
      [ "info"      ] = info,
      [ "key"       ] = key,
    }
    if index[ key ] then
      index[ key ].count = index[ key ].count + item.count
    else
      table.insert( data, item )
      index[ key ] = item
    end
  end
  return data
end


function save_rukzak( id, data )
  local prefix = "dsh_rukzak." .. id
  local sections   = {}
  local conds      = {}
  local game_types = {}
  local counts     = {}
  local infos      = {}
  local all_types  = {}
  local types_idx  = {}
  for _, item in ipairs( data ) do
    if item.count > 0 then
      local gt = item.game_type or ""
      if not types_idx[ gt ] then
        table.insert( all_types, gt )
        types_idx[ gt ] = table.getn( all_types )
      end
      table.insert( sections,   item.section )
      table.insert( conds,      string.format( "%.2f", item.condition ) )
      table.insert( game_types, types_idx[ gt ] )
      table.insert( counts,     item.count   )
      table.insert( infos,      item.info    )
    end
  end
  if table.getn( sections ) > 0 then
    ogse.save_var(
      prefix .. ".all_types", all_types,  "array_template", { "string" }
    )
    ogse.save_var(
      prefix .. ".conds",     conds,      "array_template", { "float"  }
    )
    ogse.save_var(
      prefix .. ".counts",    counts,     "array_template", { "u32"    }
    )
    ogse.save_var(
      prefix .. ".infos",     infos,      "array_template", { "string" }
    )
    ogse.save_var(
      prefix .. ".sections",  sections,   "array_template", { "string" }
    )
    ogse.save_var(
      prefix .. ".types",     game_types, "array_template", { "u8"     }
    )
  else
    ogse.delete_var( prefix .. ".access_time" )
    ogse.delete_var( prefix .. ".all_types"   )
    ogse.delete_var( prefix .. ".conds"       )
    ogse.delete_var( prefix .. ".counts"      )
    ogse.delete_var( prefix .. ".infos"       )
    ogse.delete_var( prefix .. ".inv_drop"    )
    ogse.delete_var( prefix .. ".metka"       )
    ogse.delete_var( prefix .. ".sections"    )
    ogse.delete_var( prefix .. ".types"       )
    ogse.delete_var( prefix .. ".zamok"       )
    ogse.delete_var( "dsh_rukzak.add" .. id )
  end
  return table.getn( sections )
end


function get_item_info( obj )
  local sect = obj:section()
  local info
  if
    string.find( sect, "arc_art_box_", 1, true )
    or dsh.is_artefact( sect )
    or obj:is_outfit()
  then
    local sobj = alife():object( obj:id() )
    info = sobj.custom_data or ""
  elseif obj:is_weapon_magazined() then
    info = get_wpn_info( obj )
  else
    info = ""
  end
  return info
end


function get_wpn_info( wpn )
  local info = {}
  local gl_status, has_gl = 0, false
  if wpn:is_weapon_gl() then
    if
      ogse_wpn_utils.get_grenade_launcher_status( wpn ) == 2
      and ogse_wpn_utils.get_grenade_launcher_flag( wpn )
    then
      gl_status = 1
    end
    has_gl = (
      ogse_wpn_utils.get_grenade_launcher_status( wpn ) == 1
      or gl_status == 1
    )
  end
  if has_gl and ogse_wpn_utils.get_gl_mode( wpn ) then
    local hidden_t = ogse_wpn_utils.get_hidden_ammo_type( wpn )
    local hidden_n = ogse_wpn_utils.get_ammo_elapsed2( wpn )
    table.insert( info, hidden_t )
    table.insert( info, hidden_n )
    local cur_t = ogse_wpn_utils.get_active_ammo_type( wpn )
    table.insert( info, cur_t    )
    local cur_n = wpn:get_ammo_in_magazine()
    table.insert( info, cur_n    )
  else
    local cur_t = ogse_wpn_utils.get_active_ammo_type( wpn )
    table.insert( info, cur_t )
    local cur_n = wpn:get_ammo_in_magazine()
    table.insert( info, cur_n )
    if has_gl then
      local hidden_t = ogse_wpn_utils.get_hidden_ammo_type( wpn )
      local hidden_n = ogse_wpn_utils.get_ammo_elapsed2( wpn )
      table.insert( info, hidden_t )
      table.insert( info, hidden_n )
    else
      table.insert( info, 0 )
      table.insert( info, 0 )
    end
  end
  local scope_status = 0
  if
    ogse_wpn_utils.get_scope_status( wpn ) == 2
    and
    ogse_wpn_utils.get_scope_flag( wpn )
  then
    scope_status = 1
  end
  local silencer_status = 0
  if
    ogse_wpn_utils.get_silencer_status( wpn ) == 2
    and
    ogse_wpn_utils.get_silencer_flag( wpn )
  then
    silencer_status = 1
  end
  table.insert( info, scope_status    )
  table.insert( info, gl_status       )
  table.insert( info, silencer_status )
  return table.concat( info, "," ), info
end


function spawn_ammo_in_inv( sect, box_size, who )
  if not who then who = db.actor end
  local pos, lvid, gvid, id
  if type( who.id ) == "function" then
    pos, lvid, gvid, id =
      who:position(),
      who:level_vertex_id(),
      who:game_vertex_id(),
      who:id()
  else
    pos, lvid, gvid, id =
      who.position,
      who.m_level_vertex_id,
      who.m_game_vertex_id,
      who.id
  end
  return create_ammo( sect, pos, lvid, gvid, id, box_size )
end


function spawn_item_in_inv( sect, who )
  if not who then who = db.actor end
  local pos, lvid, gvid, id
  if type( who.id ) == "function" then
    pos, lvid, gvid, id =
      who:position(),
      who:level_vertex_id(),
      who:game_vertex_id(),
      who:id()
  else
    pos, lvid, gvid, id =
      who.position,
      who.m_level_vertex_id,
      who.m_game_vertex_id,
      who.id
  end
  local sobj = create( sect, pos, lvid, gvid, id )
  return alife():object( sobj.id )
end


function parse_weapon_info_str( info_str )
  local ammo1_t, ammo1_n, ammo2_t, ammo2_n, scope, gl, silencer =
    unpack( split_comma_separated_list( info_str ) )
  ammo1_t = tonumber( ammo1_t )
  ammo1_n = tonumber( ammo1_n )
  ammo2_t = tonumber( ammo2_t )
  ammo2_n = tonumber( ammo2_n )
  if scope    == "1" then scope    = true else scope    = false end
  if gl       == "1" then gl       = true else gl       = false end
  if silencer == "1" then silencer = true else silencer = false end
  return ammo1_t, ammo1_n, ammo2_t, ammo2_n, scope, gl, silencer
end


local addons_flags = {
  scope    = 1,
  gl       = 2,
  silencer = 4,
}

function spawn_weapon_in_inv( sect, info_str, who )
  if not who then who = db.actor end
  local ammo1_t, ammo1_n, ammo2_t, ammo2_n, scope, gl, silencer =
    parse_weapon_info_str( info_str )
  if ammo1_t > 10   then ammo1_t = 0 end
  if ammo1_n > 1000 then ammo1_n = 0 end
  local addons = flags8():zero()
  addons:set( addons_flags.scope,    scope    )
  addons:set( addons_flags.gl,       gl       )
  addons:set( addons_flags.silencer, silencer )
  local func = function( e )
    local wpn  = e.sobj:get_weapon()
    wpn.addon_flags  = addons
    wpn.ammo_type    = ammo1_t
    wpn.ammo_elapsed = ammo1_n
    local wpn_gl = e.sobj:get_weapon_gl()
    if wpn_gl then
      wpn_gl.ammo_type_2    = ammo2_t
      wpn_gl.ammo_elapsed_2 = ammo2_n
    end
  end
  event( "se_item:on_before_register" ):register( func )
  local s_new_weapon = spawn_item_in_inv( sect, who )
  event( "se_item:on_before_register" ):unregister( func )
  return s_new_weapon
end


function is_item_valuable( item )
  if
    get_bool( item.section, "can_take",  true )
    and get_bool( item.section, "can_trade", true )
    -- and ( not amk_offline_alife.always_keep_item[ item.section ] )
    and ( not protected_items.is_protected_item_actor( item.section ) )
  then
    local cost = get_float( item.section, "cost", 0 )
    if item.game_type == "weapon" and cost >= 1000 then
      return true
    elseif cost >= 800 then
      return true
    end
  end
  return false
end


function get_actor_items( check_f )
  local items_our = {}
  local by_key    = {}
  if not check_f then check_f = this.can_include_into_actor_items end
  for i = 0, db.actor:object_count() - 1 do
    local obj = actor_object( i )
    if
      alife():object( obj:id() ) and ( not db.actor:marked_dropped( obj ) )
      and check_f( obj )
    then
      local sect = obj:section()
      local cond = string.format( "%.2f", obj:condition() * 100 )
      local info = get_item_info( obj )
      local key  = sect .. ":" .. cond .. ":" .. info
      local item = by_key[ key ]
      if item then
        table.insert( by_key[ key ].game_objs, obj )
      else
        item = {
          [ "section"   ] = sect,
          [ "condition" ] = tonumber( cond ),
          [ "game_objs" ] = { obj },
          [ "game_type" ] = get_game_type( obj ),
          [ "info"      ] = info,
          [ "key"       ] = key,
        }
        by_key[ key ] = item
        table.insert( items_our, item )
      end
      if item.game_type == "ammo" then
        if item.count then
          item.count = item.count + obj:get_current_ammo()
        else
          item.count = obj:get_current_ammo()
        end
      end
    end
  end
  return items_our
end


function can_include_into_actor_items( item )
  if db.actor:is_in_ruck( item ) or item:is_grenade() then
    local sect = item:section()
    if not get_bool( sect, "quest_item" ) then
      local igw = get_u32( sect, "inv_grid_width",  0 )
      local igh = get_u32( sect, "inv_grid_height", 0 )
      if igw > 0 and igh > 0 then
        return true
      end
    end
  end
  return false
end


function get_game_type( obj )
  local game_type
  local sect          = obj:section()
  local override_type = override_game_type( sect )
  if override_type then
    game_type = override_type
  elseif obj:is_ammo() then
    game_type = "ammo"
  elseif obj:is_knife() then
    game_type = "knife"
  elseif obj:is_weapon_magazined() then
    game_type = "weapon"
  elseif obj:is_outfit() then
    game_type = "outfit"
  elseif obj:is_artefact() then
    game_type = "artefact"
  elseif obj:is_grenade() then
    game_type = "grenade"
  elseif obj:is_missile() then
    game_type = "missile"
  elseif obj:is_scope() then
    game_type = "scope"
  elseif obj:is_silencer() then
    game_type = "silencer"
  elseif obj:is_grenade_launcher() then
    game_type = "gl"
  elseif obj:is_medkit() then
    game_type = "medkit"
  elseif obj:is_antirad() then
    game_type = "antirad"
  elseif obj:is_food_item() then
    game_type = "food"
  elseif obj:is_bottle_item() then
    game_type = "bottle"
  elseif obj:is_eatable_item() then
    game_type = "eatable"
  end
  return game_type or ""
end


local af_actor_cond = {
  [ "health_restore_speed"    ] = get_float( "actor_condition", "satiety_health_v", 0 ),
  [ "radiation_restore_speed" ] = get_float( "actor_condition", "radiation_v", 0 ),
  [ "satiety_restore_speed"   ] = get_float( "actor_condition", "satiety_v", 0 ),
  [ "power_restore_speed"     ] = get_float( "actor_condition", "satiety_power_v", 0 ),
  [ "bleeding_restore_speed"  ] = get_float( "actor_condition", "wound_incarnation_v", 0 ),
  [ "psy_health_restore_speed" ] = get_float( "actor_condition", "psy_health_v", 0 ),
}

local af_absorbs = {
  "burn_immunity",
  "strike_immunity",
  "shock_immunity",
  "wound_immunity",
  "radiation_immunity",
  "telepatic_immunity",
  "chemical_burn_immunity",
  "explosion_immunity",
  "fire_wound_immunity",
}

local af_ui_name = {
  [ "health_restore_speed"    ] = "ui_inv_health",
  [ "radiation_restore_speed" ] = "ui_inv_radiation",
  [ "satiety_restore_speed"   ] = "ui_inv_satiety",
  [ "power_restore_speed"     ] = "ui_inv_power",
  [ "bleeding_restore_speed"  ] = "ui_inv_bleeding",
  [ "burn_immunity"           ] = "ui_inv_outfit_burn_protection",
  [ "strike_immunity"         ] = "ui_inv_outfit_strike_protection",
  [ "shock_immunity"          ] = "ui_inv_outfit_shock_protection",
  [ "wound_immunity"          ] = "ui_inv_outfit_wound_protection",
  [ "radiation_immunity"      ] = "ui_inv_outfit_radiation_protection",
  [ "telepatic_immunity"      ] = "ui_inv_outfit_telepatic_protection",
  [ "chemical_burn_immunity"  ] = "ui_inv_outfit_chemical_burn_protection",
  [ "explosion_immunity"      ] = "ui_inv_outfit_explosion_protection",
  [ "fire_wound_immunity"     ] = "ui_inv_outfit_fire_wound_protection",
  [ "psy_health_restore_speed"     ] = "ui_inv_psy_health",
  [ "additional_inventory_weight"  ] = "ui_inv_additional_weight",
  [ "additional_inventory_weight2" ] = "ui_inv_additional_weight2",
}

function get_art_info_text( sect )
  local texts = {}
  for k, v in pairs( af_actor_cond ) do
    local af_val = get_float( sect, k, 0 )
    if af_val ~= 0 then
      af_val = af_val / v * 100
      local sn = "%"
      if k == "radiation_restore_speed" or k == "power_restore_speed" then
        af_val = af_val / 100
        sn     = ""
      end
      local color
      if af_val > 0 then
        color = "%c[green]"
      else
        color = "%c[red]"
      end
      if k == "bleeding_restore_speed" then
        af_val = af_val * -1
      end
      if k == "bleeding_restore_speed" or k == "radiation_restore_speed" then
        if af_val > 0 then
          color = "%c[red]"
        else
          color = "%c[green]"
        end
      end
      table.insert(
        texts,
        string.format(
          "%%c[default]• %-12s %s%+.0f %s",
          translate( af_ui_name[ k ] ), color, af_val, sn
        )
      )
    end
  end

  for _, k in ipairs({
    "additional_inventory_weight", "additional_inventory_weight2"
  }) do
    local af_val = get_float( sect, k, 0 )
    if k == "additional_inventory_weight" then
      local af_val2 = get_float( sect, "additional_inventory_weight2", 0 )
      if af_val == af_val2 then af_val = 0 end
    end
    if af_val ~= 0 then
      local sn = ""
      local color
      if af_val > 0 then
        color = "%c[green]"
      else
        color = "%c[red]"
      end
      table.insert(
        texts,
        string.format(
          "%%c[default]• %-12s %s%+.0f %s",
          translate( af_ui_name[ k ] ), color, af_val, sn
        )
      )
    end
  end

  local absorb_sect = get_string( sect, "hit_absorbation_sect" )
  if sys_ini:section_exist( absorb_sect ) then
    for _, k in ipairs( af_absorbs ) do
      local af_val = get_float( absorb_sect, k, 0 )
      if af_val ~= 1 then
        af_val = ( 1 - af_val ) * 100
        local color
        if af_val > 0 then
          color = "%c[green]"
        else
          color = "%c[red]"
        end
        table.insert(
          texts,
          string.format(
            "%%c[default]• %-12s %s%+.0f %s",
            translate( af_ui_name[ k ] ), color, af_val, "%"
          )
        )
      end
    end
  end

  if table.getn( texts ) > 0 then
    return table.concat( texts, "\\n" )
  end
end


-- cp2ogsr: добавлено описание характеристик брони
function get_outfit_info_text( item )
  local texts = {}
  local val, txt, sect, cond = 0, "", item.section, item.condition

  -- скрытые свойства костюмов
  for i, t in ipairs( ui_inv_descr.conditions_params ) do
    -- val = sys_ini:r_float( sect, t.prop, 0 )
    val = get_float( sect, t.prop, 0 )
    if val ~= 0 then
      val = val * 100 / ui_inv_descr.conditions[ t.prop ]
      txt = t.text .. " "
      if t.prop == "bleeding_restore_speed" then
        txt = txt .. ( val > 0 and "%c[green]" or "%c[red]+" )
        val = -val
      elseif t.prop == "radiation_restore_speed" then
        txt = txt .. ( val > 0 and "%c[red]+" or "%c[green]" )
      else
        txt = txt .. ( val > 0 and "%c[green]+" or "%c[red]" )
      end
      txt = txt .. string.format( "%d", val ) .. ( t.unit or "%" )
      table.insert( texts, "• " .. txt )
    end
  end

  for i, t in ipairs( ui_inv_descr.hit_types ) do
    val = get_float( sect, t.prop .. "_protection", 0 )
    if val > 0 then
      local orig_val = val * 100 -- Prophet13: выводим дополнительно хар-ки без учёта текущего condition.
      val = val * cond
      -- Prophet13: Округляем числа, ибо string.format просто убирает все числа после запятой.
      txt = t.text .. " " .. (val < 0 and "%c[red]" or "%c[green]+") .. string.format("%d%%", math.round(val)) .. " | " .. (val < 0 and "%c[red]" or "%c[green]+") .. string.format("%d%%", math.round(orig_val))
      table.insert( texts, "• " .. txt )
    end
  end

  -- Доп. вес
  val = get_float( sect, "additional_inventory_weight2", 0 )
  if val > 0 then
    txt = translate( "st_load_capacity" ) .. ": %c[green]+" .. string.format( "%.1f", val )
    local val2 = get_float( sect, "additional_inventory_weight", 0 )
    if val2 ~= val then
      txt = txt .. string.format( " (%.1f)", val2 )
    end
    table.insert( texts, "• " .. txt .. " " .. translate( "ui_inv_s_kg" ) )
  end

  -- Доп. прыжок
  val = get_float( sect, "additional_jump_height", 0 )
  if val > 0 then
    txt = translate( "ui_inv_jump_height" ) .. ": %c[green] x" .. string.format( "%.1f", val )
    table.insert( texts, "• " .. txt )
  end

  -- Расход энергии
  val = get_float( sect, "discharge_step", 0 )
  if val > 0 then
    txt = translate( "ui_inv_energy_consumption" ) .. ": %c[red]" .. string.format( "%1.0f", val * 100000 )
    table.insert( texts, "• " .. txt )
  end

  if table.getn( texts ) > 0 then
    return table.concat( texts, "\\n%c[default]" )
  end
end


function bind( obj )
  local new_binder = generic_rukzak_binder( obj )
  obj:bind_object( new_binder )
end


class "generic_rukzak_binder" ( object_binder )
function generic_rukzak_binder:__init( obj ) super( obj )
  self.am = ogse_signals.get_mgr()
  self.object:set_nonscript_usable( true )
end


function generic_rukzak_binder:net_spawn( data )
  if not object_binder.net_spawn( self, data ) then
    return false
  end
  local prefix   = "dsh_rukzak." .. self.object:id()
  local inv_drop = ogse.load_var( prefix .. ".inv_drop", false, "bool" )
  if inv_drop then
    self.dsh_tip_text = "inventory_item_use"
  end
  self.object:set_tip_text( self.dsh_tip_text or "st_search_treasure" )
  self.object:set_callback(
    callback.use_object, generic_rukzak_binder.use_callback, self
  )
  self.am:call( "on_ph_spawn", self.object, self )
  return true
end


function generic_rukzak_binder:update( delta )
  object_binder.update( self, delta )
  self.am:call( "on_physic_obj_update", self.object, delta )
  self.am:call(
    "on_ph_update." .. self.object:id(), self.object, delta
  )
end


function generic_rukzak_binder:net_destroy()
  self.object:set_callback( callback.use_object, nil )
  self.am:call( "on_ph_net_destroy", self.object, self )
  self.am:cleanup_signal_subs( "on_ph_update." .. self.object:id() )
  object_binder.net_destroy( self )
end


function generic_rukzak_binder:use_callback( obj, who )
  self.am:call( "on_rukzak_use", self.object )
end


local en_icons
class "rukzak_item" ( CUIListItemEx )
function rukzak_item:__init( xml, name, cond, cnt, sect ) super()
  xml:InitWindow( "list_item", 0, self )
  self:SetAutoDelete( true )
  self.item_cnt  = xml:InitStatic( "list_item_num",  self )
  self.item_cnt:SetText( cnt )
  self.item_name = xml:InitStatic( "list_item_name", self )
  self.item_name:SetText( name )

  if en_icons then
    local l_item_icon = xml:InitStatic( "list_item_icon", self )
      dsh_ui.set_item_icon(
      sect, l_item_icon, l_item_icon:GetWidth(), l_item_icon:GetHeight()
    )
  end

  -- cp2ogsr: не показываем состояние, если предмет целый + цвет в зависимости от состояния
  if cond < 100 then
    self.item_cond = xml:InitStatic( "list_item_cond", self )
    local g = math.min( ( cond / 100 ) * 510, 255 )
    local r = math.min( ( 1 - ( cond / 100 ) ) * 510, 255 )
    self.item_cond:SetTextColor( 255, r, g, 0 )
    self.item_cond:SetText( string.format( "%.1f%%", cond ) )
  end
end


class "ui_rukzak_other" ( CUIWindow )
function ui_rukzak_other:__init() super() end


function ui_rukzak_other:InitControls( xml, handler )
  xml:InitWindow( "tab_other", 0, self )
  self:SetAutoDelete( true )

  self.bk = xml:InitFrame( "list_frame", self )

  handler.ui_list_other = xml:InitList( "tab_other:list", self )
  handler.ui_list_other:ShowSelectedItem( true )
  handler:Register( handler.ui_list_other, "list_other" )
end


class "ui_rukzak_our" ( CUIWindow )
function ui_rukzak_our:__init() super() end


function ui_rukzak_our:InitControls( xml, handler )
  xml:InitWindow( "tab_our", 0, self )
  self:SetAutoDelete( true )

  self.bk = xml:InitFrame( "list_frame", self )

  handler.ui_list_our = xml:InitList( "tab_our:list", self )
  handler.ui_list_our:ShowSelectedItem( true )
  handler:Register( handler.ui_list_our, "list_our" )
end


local xml = CScriptXmlInit()
xml:ParseFile( "ui_dsh_rukzak.xml" )

class "ui_rukzak" ( dsh_ui.dshCUIScriptWnd )
function ui_rukzak:__init( owner_id ) super()
  self.changed   = false
  self.index_other = {}
  self.index_our   = {}
  self.moved     = false
  self.owner_id  = owner_id
  self.spawning  = {}
  self:InitControls()
  self:InitCallBacks()
  local t = ogse.load_var( "dsh_rukzak.add" .. owner_id, {} )
  en_icons = t[ 4 ]
  if self.owner_id then
    self:FillOtherList()
    self:FillOurList()
  end
  if t[ 1 ] then self.radio_show:SetNewActiveTab( t[ 1 ] ) end
  if t[ 2 ] then self.radio_sort:SetNewActiveTab( t[ 2 ] ) end
  if t[ 3 ] == true then self:revers() end
end


function ui_rukzak:InitControls()
  xml:InitWindow( "main_dialog", 0, self )
  self.dialog = xml:InitStatic( "main_dialog:dialog", self )

  self.dlg_other = ui_rukzak_other()
  self.dlg_other:InitControls( xml, self )
  self.dialog:AttachChild( self.dlg_other )
  self.crevers = self.dlg_other:GetWndPos().x

  self.dlg_our = ui_rukzak_our()
  self.dlg_our:InitControls( xml, self )
  -- self.dlg_our:Show( false )
  self.dialog:AttachChild( self.dlg_our )

  self.edit_amount = xml:InitEditBox( "main_dialog:edit_amount", self.dialog )
  self:reset_edit_amount()
  self:Register( self.edit_amount, "edit_amount" )

  self.btn_icons = xml:Init3tButton( "main_dialog:btn_icons", self.dialog )
  self:Register( self.btn_icons, "btn_icons" )

  self.btn_revers = xml:Init3tButton( "main_dialog:btn_revers", self.dialog )
  self:Register( self.btn_revers, "btn_revers" )

  self.btn_4 = xml:Init3tButton( "main_dialog:btn_4", self.dialog )
  self:Register( self.btn_4, "btn_4" )
  self.btn_4:Enable( false )

  self.btn_move_all = xml:Init3tButton(
    "main_dialog:btn_move_all", self.dialog
  )
  self:Register( self.btn_move_all, "btn_move_all" )
  self.btn_move_all:Enable( false )

  self.label_weight = xml:InitStatic( "main_dialog:label_weight", self.dialog )
  self:show_cur_weight()

  local btn_quit = xml:Init3tButton( "main_dialog:btn_quit", self.dialog )
  btn_quit:SetAccelerator( bind_to_dik( key_bindings.kUSE ), 0 )
  self:Register( btn_quit, "btn_quit" )

  local btn_take = xml:Init3tButton( "main_dialog:btn_take", self.dialog )
  self:Register( btn_take, "btn_take" )

  -- self.tab = xml:InitTab( "main_dialog:tab", self.dialog )
  -- self:Register( self.tab, "tab" )

  xml:InitStatic( "main_dialog:label_filter", self.dialog )
  self.edit_filter = xml:InitEditBox( "main_dialog:edit_filter", self.dialog )
  self:Register( self.edit_filter, "edit_filter" )

  xml:InitStatic( "main_dialog:label_show", self.dialog )
  self.radio_show = xml:InitTab( "main_dialog:radio_show", self.dialog )
  self:Register( self.radio_show, "radio_show" )

  xml:InitStatic( "main_dialog:label_sort", self.dialog )
  self.radio_sort = xml:InitTab( "main_dialog:radio_sort", self.dialog )
  self:Register( self.radio_sort, "radio_sort" )

  self.descr_scroll = xml:InitScrollView(
    "main_dialog:descr_scroll", self.dialog
  )

  self.item_icon = xml:InitStatic( "main_dialog:item_icon", self.dialog )
  self.item_icon_w = self.item_icon:GetWidth()
  self.item_icon_h = self.item_icon:GetHeight()
end


function ui_rukzak:InitCallBacks()
  -- self:dshAddCallback( "tab", ui_events.TAB_CHANGED, self.OnTabChange, self )
  self:dshAddCallback( "btn_icons", ui_events.BUTTON_CLICKED, self.sw_icons, self )
  self:dshAddCallback( "btn_revers", ui_events.BUTTON_CLICKED, self.revers, self )
  self:dshAddCallback( "btn_4", ui_events.BUTTON_CLICKED, self.rep_btn, self )
  self:dshAddCallback(
    "btn_quit", ui_events.BUTTON_CLICKED, self.on_quit, self
  )
  self:dshAddCallback(
    "btn_take", ui_events.BUTTON_CLICKED, self.on_take, self
  )
  self:dshAddCallback(
    "list_other", ui_events.LIST_ITEM_CLICKED, self.OnListItemClickedOther, self
  )
  self:dshAddCallback(
    "list_other", ui_events.WINDOW_LBUTTON_DB_CLICK, self.OnListItemDbClicked,
    self
  )
  self:dshAddCallback(
    "list_our", ui_events.LIST_ITEM_CLICKED, self.OnListItemClickedOur, self
  )
  self:dshAddCallback(
    "list_our", ui_events.WINDOW_LBUTTON_DB_CLICK, self.OnListItemDbClicked,
    self
  )
  self:dshAddCallback(
    "edit_amount", ui_events.EDIT_TEXT_COMMIT, self.rep_btn, self
  )
  self:dshAddCallback(
    "edit_filter", ui_events.EDIT_TEXT_COMMIT, self.OnSearchEnter, self
  )
  self:dshAddCallback(
    "radio_show", ui_events.TAB_CHANGED, self.OnShowChange, self
  )
  self:dshAddCallback(
    "radio_sort", ui_events.TAB_CHANGED, self.OnSortChange, self
  )
  self:dshAddCallback(
    "btn_move_all", ui_events.BUTTON_CLICKED, self.OnMoveAllClicked, self
  )
end


function ui_rukzak:revers()
  local pos1, pos2 = self.dlg_our:GetWndPos(), self.dlg_other:GetWndPos()
  self.dlg_our:SetWndPos( pos2.x, pos1.y )
  self.dlg_other:SetWndPos( pos1.x, pos2.y )
  if self.crevers ~= pos1.x then
    self.is_revers = true
  else
    self.is_revers = false
  end
end


function ui_rukzak:sw_icons()
  en_icons = not en_icons
end


function ui_rukzak:OnKeyboard( dik, keyboard_action )
  CUIScriptWnd.OnKeyboard( self, dik, keyboard_action )
  if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
    if dik == DIK_keys.DIK_ESCAPE then
      self:on_quit()
    end
  end
  return true
end


function ui_rukzak:OnTabChange()
  -- self.dlg_other:Show( false )
  -- self.dlg_our:Show( false )
  if self.moved then
    self:show_filtered_items( true, true )
    self.moved = false
  end
--[=[
  local i = self.tab:GetActiveIndex()
  if     i == 0 then
    self.dlg_other:Show( true )
  elseif i == 1 then
    self.dlg_our:Show( true )
  end
--]=]
  self:reset_edit_amount()
  self.btn_4:Enable( false )
  self.btn_move_all:Enable( false )
end


function ui_rukzak:rep_btn()
  local amount = tonumber( self.edit_amount:GetText() ) or 1
  self:move_items( amount )
end


function ui_rukzak:OnMoveAllClicked()
  local ui_item = self:get_selected_item()
  if ui_item then
    local amount = tonumber( ui_item.item_cnt:GetText() ) or 1
    self:move_items( amount )
  end
end


function ui_rukzak:move_items( amount )
  local ui_item = self:get_selected_item()
  if not ui_item then return end
  self.changed = true
  self.moved   = true
  if ui_item.data.game_objs then
    self:move_by_amount(
      function()
        return self:move_from_our( ui_item )
      end,
      amount
    )
  else
    self:move_by_amount(
      function()
        return self:move_from_other( ui_item )
      end,
      amount
    )
    if self:is_rukzak_empty() then
      spawn_item_in_inv( "treasure_item" )
      release( self.owner_id )
      return self:on_quit()
    end
  end
  self:reset_edit_amount()
  self:show_cur_weight_delay()
end


function ui_rukzak:is_rukzak_empty()
  for _, item in ipairs( self.items_other ) do
    if item.count > 0 then return false end
  end
  return true
end


function ui_rukzak:move_by_amount( f, amount )
  while amount > 0 do
    local moved = f()
    if moved == 0 then moved = amount end
    amount = amount - moved
  end
end


function ui_rukzak:move_from_other( ui_item, quiet )
  local item   = ui_item.data
  local ui_our = self.index_our[ item.key ]
  local our
  if ui_our then
    our = ui_our.data
  else
    our = {
      [ "section"   ] = item.section,
      [ "condition" ] = item.condition,
      [ "game_type" ] = item.game_type,
      [ "game_objs" ] = {},
      [ "info"      ] = item.info,
      [ "key"       ] = item.key,
      [ "name"      ] = item.name,
    }
    table.insert( self.items_our, our )
  end
  local size, sobj = self:create_actor_item( item, our )
  if ui_our then
    ui_our.item_cnt:SetText(
      our.count or table.getn( our.game_objs )
    )
  else
    ui_our = rukzak_item(
      xml, ui_item.item_name:GetText(), our.condition,
      ( our.count or table.getn( our.game_objs ) ), our.section
    )
    ui_our.data = our
    self.index_our[ our.key ] = ui_our
  end
  self.spawning[ sobj.id ] = true
  level.client_spawn_manager():add(
    sobj.id, -1, function( id, obj )
      table.insert( our.game_objs, obj )
      ui_our.item_cnt:SetText(
        our.count or table.getn( our.game_objs )
      )
      self.spawning[ sobj.id ] = nil
    end
  )
  if item.count > 0 then
    ui_item.item_cnt:SetText( item.count )
  else
    local pos = self.ui_list_other:GetItemPos( ui_item )
    self.index_other[ item.key ] = nil
    self.ui_list_other:RemoveItem( pos )
    if     item.section == "amk_metka" then
      amk.send_tip( "Убрана метка со списком вещей.", nil, nil, 5 )
    elseif item.section == "zamok" then
      if not ( self:is_rukzak_empty() or quiet ) then
        amk.send_tip( "С тайника убрали замок.", nil, nil, 5 )
      end
    end
    size = 0
  end
  if ui_our and not self.ui_list_our:IsChild( ui_our ) then self.ui_list_our:AddItem( ui_our ) end
  return size
end


function ui_rukzak:create_actor_item( item, our )
  local size, sobj

  if item.game_type == "ammo" then
    if not our.count then our.count = 0 end
    local box_size = get_u32( item.section, "box_size" )
    if item.count > box_size then
      sobj = spawn_ammo_in_inv( item.section, box_size )
      size = box_size
      item.count = item.count - box_size
      our.count  = our.count  + box_size
    else
      sobj = spawn_ammo_in_inv( item.section, item.count )
      size = item.count
      our.count  = our.count  + item.count
      item.count = 0
    end
  else
    if item.game_type == "weapon" then
      sobj = spawn_weapon_in_inv( item.section, item.info )
    else
      sobj = spawn_item_in_inv( item.section )
    end
    if
      string.find( item.section, "arc_art_box_", 1, true )
      or dsh.is_artefact( item.section )
      or item.game_type == "outfit"
    then
      sobj.custom_data = item.info or ""
    end
    item.count = item.count - 1
    size       = 1
  end

  if item.condition < 100 then
    sobj = alife():object( sobj.id )
    local iitem = sobj:get_inventory_item()
    iitem.item_condition = item.condition / 100
  end

  return size, sobj
end


function ui_rukzak:move_from_our( ui_item )
  local item     = ui_item.data
  --
  if item.game_type == "weapon" then
    local ammo1_t, ammo1_n, ammo2_t, ammo2_n, scope, gl, silencer =
    parse_weapon_info_str( item.info )
    -- log2( "%s,%s,%s,%s,%s,%s,%s", ammo1_t, ammo1_n, ammo2_t, ammo2_n, scope, gl, silencer )
	  local sr = get_u32( item.section, "scope_status" ) == 2 and get_string( item.section, "scope_respawn" )
    if sr then
        if scope == true then
          got_item( get_string( item.section, "scope_name" ) )
          scope = 0
        end
        item.section = sr
	  end
    if gl == true then gl = 1 else gl = 0 end
    if silencer == true then silencer = 1 else silencer = 0 end
    item.info = string.format( "%s,%s,%s,%s,%s,%s,%s", ammo1_t, ammo1_n, ammo2_t, ammo2_n, scope, gl, silencer )
    item.key = item.section .. ":" .. string.format( "%.2f", item.condition ) .. ":" .. item.info
  end
  --
  local obj      = table.remove( item.game_objs, 1 )
  local ui_other = self.index_other[ item.key ]
  local other
  if ui_other then
    other = ui_other.data
  else
    other = {
      [ "section"   ] = item.section,
      [ "condition" ] = item.condition,
      [ "game_type" ] = item.game_type,
      [ "count"     ] = 0,
      [ "info"      ] = item.info,
      [ "key"       ] = item.key,
      [ "name"      ] = item.name,
    }
    table.insert( self.items_other, other )
  end
  local size
  if item.game_type == "ammo" then
    size = obj:get_current_ammo()
    item.count = item.count - size
  else
    size = 1
  end
  if size > 0 then
    other.count = other.count + size
    if ui_other then
      ui_other.item_cnt:SetText( other.count )
    else
      ui_other = rukzak_item(
        xml, ui_item.item_name:GetText(), other.condition, other.count, other.section
      )
      ui_other.data = other
      self.index_other[ other.key ] = ui_other
    end
  end
  if table.getn( item.game_objs ) > 0 then
    ui_item.item_cnt:SetText(
      item.count or table.getn( item.game_objs )
    )
  else
    local pos = self.ui_list_our:GetItemPos( ui_item )
    self.index_our[ item.key ] = nil
    self.ui_list_our:RemoveItem( pos )
    size = 0
  end
  release( obj )
  if other.count == 1 then
    if item.section == "zamok" then
      sms2( "Заперли тайник на замок.", nil, nil, 5 )
    elseif item.section == "amk_metka" then
      sms2( "Установлена метка со списком вещей.", nil, nil, 5 )
    end
  end
  if ui_other and not self.ui_list_other:IsChild( ui_other ) then self.ui_list_other:AddItem( ui_other ) end
  return size
end


function ui_rukzak:get_current_list_box()
  local list_box
  local i = self.tab:GetActiveIndex()
  if     i == 0 then
    list_box = self.ui_list_other
  elseif i == 1 then
    list_box = self.ui_list_our
  end
  return list_box
end


local selected_list
function ui_rukzak:get_selected_item()
  local list_box = selected_list
  local item
  if list_box and list_box:GetSize() > 0 then
    local itm_index = list_box:GetSelectedItem()
    if itm_index >= 0 then
      item = list_box:GetItem( itm_index )
    end
  end
  return item
end


local inv_close_snd = sound_object( "interface\\inv_close" )

function ui_rukzak:on_quit()
  if self.changed then
    save_rukzak(self.owner_id, self.items_other)
  end
  if self.weight_timer then self.weight_timer:stop() end
  self:GetHolder():start_stop_menu( self, true )
  self:clean_spawn_manager()
  self:clear_all_lists()
  self.ui_list_other = nil
  self.ui_list_our   = nil
  self:dsh_unregister_self()
  active_ui_rukzak = false
  add_gps_list(self.owner_id)
  -- db.actor:restore_weapon()
  -- bind_stalker.restore_weapon()
  inv_close_snd:play( db.actor, 0, sound_object.s2d )
  dsh.timeout( 100,  -- Тут нужна небольшая задержка
    function() flag_use = false end
  )
  ogse.save_var( "dsh_rukzak.add" .. self.owner_id, { self.radio_show:GetActiveIndex(), self.radio_sort:GetActiveIndex(), self.is_revers, en_icons } )
  selected_list = nil
end


function ui_rukzak:OnListItemClickedOther()
  selected_list = self.ui_list_other
  self:OnListItemClicked()
end


function ui_rukzak:OnListItemClickedOur()
  selected_list = self.ui_list_our
  self:OnListItemClicked()
end

  
function ui_rukzak:OnListItemClicked()
  local item = self:get_selected_item()
  if not item then return end
  self:show_item_descr( item )
  self:reset_edit_amount()
  self.btn_4:Enable( true )
  self.btn_move_all:Enable( true )
  -- log3( "~~[%s.ui_rukzak:OnListItemClicked]: PROCESS: %s", script_name(), type( selected_list ) )
end


function ui_rukzak:OnListItemDbClicked()
  self:rep_btn()
end


function ui_rukzak:FillOtherList()
  self.items_other = load_rukzak( self.owner_id )
  self:FillList( self.items_other, self.ui_list_other, self.index_other )
end


function ui_rukzak:FillList( items, ui_list, index )
  for _, item in ipairs( items ) do
    if
      ( item.count and item.count > 0 )
      or ( item.game_objs and table.getn( item.game_objs ) > 0 )
    then
      if not item.name then
        local sect = item.section
        local name = get_string(
          sect, "inv_name", get_string( sect, "inv_name_short" )
        )
        item.name = dsh.strip_quotes( translate( name ) )
      end
      if not index[ item.key ] then
        local ui_item = rukzak_item(
          xml, item.name, item.condition,
          ( item.count or table.getn( item.game_objs ) ), item.section
        )
        ui_item.data      = item
        index[ item.key ] = ui_item
      end
      ui_list:AddItem( index[ item.key ] )
    end
  end
end


function ui_rukzak:FillOurList()
  self.items_our = get_actor_items()
  self:FillList( self.items_our, self.ui_list_our, self.index_our )
end


function ui_rukzak:show_cur_weight()
  local inv_weight = db.actor:get_inventory_weight()
  local max_weight = db.actor:get_max_weight()
  if inv_weight > max_weight then
    self.label_weight:SetTextColor( 255, 255,  50,  0 )
  else
    self.label_weight:SetTextColor( 255, 238, 153, 26 )
  end
  self.label_weight:SetText( string.format( translate( "ui_inv_weight" ) .. ": %.1f / %.1f [%.1f] кг.", inv_weight, max_weight, db.actor:get_max_walk_weight() ) )
end


function ui_rukzak:show_cur_weight_delay()
  if not self.weight_timer then
    self.weight_timer = dsh.timeout(
      250, function()
        self:show_cur_weight()
        self.weight_timer = nil
      end
    )
  end
end


function ui_rukzak:reset_edit_amount()
  self.edit_amount:SetText( "1" )
end


function ui_rukzak:OnSearchEnter()
  self:show_filtered_items( true )
end


function ui_rukzak:search_items( items )
  local term = string.lower( self.edit_filter:GetText() )
  if term ~= "" then
    items = self:grep_items_by( items, function( item, show_type )
      return string.find( string.lower( item.name ), term, 1, true )
    end )
  end
  return items
end


function ui_rukzak:clear_all_lists()
  self.index_other = {}
  self.index_our   = {}
  self.ui_list_other:RemoveAll()
  self.ui_list_our:RemoveAll()
end


function ui_rukzak:grep_items_by( items, f )
    local filtered = {}
    for _, item in pairs( items ) do
      if f( item, self:get_show_type( item ) ) then
        table.insert( filtered, item )
      end
    end
    return filtered
end


function ui_rukzak:get_show_type( item )
  if not item.show_type then
    item.show_type = get_string(
      item.section, "dsh_rukzak.override_show_type", item.game_type
    )
  end
  return item.show_type == "other" and "" or item.show_type
end


function ui_rukzak:sort_items( items )
  local sort_idx = self.radio_sort:GetActiveIndex()
  local sort_func
  if     sort_idx == 1 then
    sort_func = function( a, b )
      return dsh.remove_quotes( string.lower( a.name ) ) < dsh.remove_quotes( string.lower( b.name ) )
    end
  elseif sort_idx == 2 then
    sort_func = function( a, b )
      return dsh.remove_quotes( string.lower( a.name ) ) > dsh.remove_quotes( string.lower( b.name ) )
    end
  elseif sort_idx == 3 then
    sort_func = function( a, b )
      return a.condition < b.condition
    end
  elseif sort_idx == 4 then
    sort_func = function( a, b )
      return a.condition > b.condition
    end
  elseif sort_idx == 5 then
    sort_func = function( a, b )
      local cnt_a = a.count or table.getn( a.game_objs )
      local cnt_b = b.count or table.getn( b.game_objs )
      return cnt_a < cnt_b
    end
  elseif sort_idx == 6 then
    sort_func = function( a, b )
      local cnt_a = a.count or table.getn( a.game_objs )
      local cnt_b = b.count or table.getn( b.game_objs )
      return cnt_a > cnt_b
    end
  end
  if sort_func then
    items = table.clone_simple( items )
    table.sort( items, sort_func )
  end
  return items
end


function ui_rukzak:OnShowChange()
  self:show_filtered_items( false, true )
end


function ui_rukzak:show_filtered_items( keep_search, force )
  self:clear_all_lists()
  local show_idx = self.radio_show:GetActiveIndex()
  local filtered_other = self.filtered_other
  local filtered_our   = self.filtered_our
  if not ( filtered_other and filtered_our ) or force then
    local by_type
    if     show_idx == 1 then   -- оружие
      by_type = function( item, show_type )
        return show_type == "weapon" or show_type == "knife"
      end
    elseif show_idx == 2 then   -- патроны
      by_type = function( item, show_type )
        return show_type == "ammo"
      end
    elseif show_idx == 3 then   -- гранаты
      by_type = function( item, show_type )
        return show_type == "grenade" or show_type == "missile"
      end
    elseif show_idx == 4 then   -- обвесы на оружие
      by_type = function( item, show_type )
        return
          show_type == "scope" or show_type == "silencer" or show_type == "gl"
      end
    elseif show_idx == 5 then   -- броня
      by_type = function( item, show_type )
        return show_type == "outfit"
      end
    elseif show_idx == 6 then   -- артефакты
      by_type = function( item, show_type )
        return show_type == "artefact"
      end
    elseif show_idx == 7 then   -- еда
      by_type = function( item, show_type )
        return show_type == "food" or show_type == "bottle"
          or show_type == "eatable"
      end
    elseif show_idx == 8 then   -- медицина
      by_type = function( item, show_type )
        return show_type == "medkit" or show_type == "antirad"
      end
    elseif show_idx == 9 then   -- части мутантов
      by_type = function( item, show_type )
        return show_type == "mutant_part"
      end
    elseif show_idx > 0 then
      by_type = function( item, show_type )
        return show_type == ""
      end
    end
    if by_type then
      filtered_other = self:grep_items_by( self.items_other, by_type )
      filtered_our   = self:grep_items_by( self.items_our,   by_type )
    else
      filtered_other = self.items_other
      filtered_our   = self.items_our
    end
    self.filtered_other = filtered_other
    self.filtered_our   = filtered_our
  end
  if keep_search then
    filtered_other = self:search_items( filtered_other )
    filtered_our   = self:search_items( filtered_our   )
  else
    self.edit_filter:SetText( "" )
  end
  filtered_other = self:sort_items( filtered_other )
  filtered_our   = self:sort_items( filtered_our   )
  self:FillList( filtered_other, self.ui_list_other, self.index_other )
  self:FillList( filtered_our,   self.ui_list_our,   self.index_our   )
end


function ui_rukzak:OnSortChange()
  self:show_filtered_items( true, self.moved )
  self.moved = false
end


function ui_rukzak:show_item_descr( ui_item )
  local sect = ui_item.data.section
  dsh_ui.set_item_icon(
    sect, self.item_icon, self.item_icon_w, self.item_icon_h
  )
  if self.item_descr then
    self.descr_scroll:Clear()
    self.item_descr:DetachFromParent()
  end
  self.item_descr = xml:InitStatic(
    "main_dialog:descr_text", self.descr_scroll
  )
  self.item_descr:SetText( self:get_item_description( ui_item.data ) )
  self.item_descr:AdjustHeightToText()
end


function ui_rukzak:get_item_description( item )
  local sect = item.section
  local text = self:get_additional_description( item ) .. dsh.strip_quotes( translate(
    get_string( sect, "description" )
  ))
  if string.find( sect, "arc_art_box_" ) then
    text = get_art_box_content( item ) .. "  \\n" .. text
  end
  if get_string( sect, "af_actor_properties" ) then
    if item.condition > 0 then
      local af_text = get_art_info_text( sect )
      if af_text then
        text = af_text .. "\\n%c[default]" .. text
      end
    end
  elseif item.game_type == "outfit" then
    local out_text = get_outfit_info_text( item )
    if out_text then
      text = out_text .. "\\n%c[default]" .. text
    end
  end
  if amk_mod.arts[ sect ] then
    text = text .. " \\n\\n%c[red]Этот артефакт имеет свойство вырождаться при выбросе!"
  end
  return text
end


function get_art_box_content( item )
  local artefacts = arc_ui_8container_menu.decode_custom_data(
    item.info, item.section
  )
  local names = {}
  for _, t in ipairs( artefacts ) do
    local sect = t.section
    if sect then
      local name = get_string( sect, "inv_name", get_string( sect, "inv_name_short" ) )
      name = dsh.strip_quotes( translate( name ) )
      name = string.format( "• %s", name )
      table.insert( names, name )
    end
  end
  local text
  if table.getn( names ) > 0 then
    text = table.concat( names, "\\n" )
  else
    text = "• Пустой"
  end
  return string.format( "Содержимое [%d/%d]:\\n", table.getn( names ), get_u32( item.section, "container_slots" ) )
    .. text .. "\\n"
end


function ui_rukzak:get_additional_description( item )
  local sect = item.section
  local iw = get_float( sect, "inv_weight", 0 ) + get_art_box_weight( item )
  local ic = get_float( sect, "cost", 0 )
  iw = string.format( "%.2f", iw )
  ic = string.format( "%.0f (%.0f)", ic, ic * ( item.condition / 100 ) )
  local text = "%c[255,238,153,26]" .. translate( "ui_inv_weight" ) .. ": " .. iw .. " кг. " .. "\\nЦена: " .. ic .. " руб.\\n"
  if item.info ~= "" and item.game_type == "weapon" then
	local ammo1_t, ammo1_n, ammo2_t, ammo2_n, scope, gl, silencer = parse_weapon_info_str( item.info )
    if ammo1_n and ammo1_n > 0 then text = text .. string.format( "Боеприпасов заряжено: %d / %d", ammo1_n, get_u32( sect, "ammo_mag_size" ) ) end
    if ammo2_n and ammo2_n > 0 then text = text .. string.format( " (%d)", ammo2_n ) end
	if scope or gl or silencer then text = text .. "\\nУстановлено: " end
    if scope then text = text .. translate( g_inv_name( get_string_wq( sect, "scope_name", "wpn_addon_scope" ) ) ) .. ", " end
    if gl then text = text .. translate( g_inv_name( get_string_wq( sect, "grenade_launcher_name", "wpn_addon_grenade_launcher" ) ) ) .. ", " end
    if silencer then text = text .. translate( g_inv_name( get_string_wq( sect, "silencer_name", "wpn_addon_silencer" ) ) ) end
    text = string.gsub( text, ", $", "" ) .. "\\n"
  end
  return text .. "%c[default]"
end


function get_art_box_weight( item )
  local w = 0
  local sect = item.section
  if not string.find( sect, "arc_art_box_", 1, true ) then return w end
  local artefacts = arc_ui_8container_menu.decode_custom_data(
    item.info, sect
  )
  for _, t in ipairs( artefacts ) do
    local sect = t.section
    if sect then
      w = w + get_float( sect, "inv_weight", 0 )
    end
  end
  -- log3( "~~[%s]: get_art_box_weight(): [%s]", script_name(), w )
  return w
end


function ui_rukzak:full_reload()
  self:clear_all_lists()
  self.changed     = false
  self.items_other = load_rukzak( self.owner_id )
  self.items_our   = get_actor_items()
  self.moved       = true
  self:OnTabChange()
end


function ui_rukzak:clean_spawn_manager()
  for id, _ in pairs( self.spawning ) do
    level.client_spawn_manager():remove( id, -1 )
    self.spawning[ id ] = nil
  end
end


function ui_rukzak:on_take()
  local t = {}
  for _, item in ipairs( self.items_other ) do
    while item.count > 0 do
      self:create_actor_item( item, t )
    end
  end
  self.changed = true
  self.items_other = {}
  spawn_item_in_inv( "treasure_item" )
  ogse.delete_var( "dsh_rukzak.add" .. self.owner_id )
  release( self.owner_id )
  self:on_quit()
end


function check_used_rucksak()
  return flag_use
end


-- Метка со списком предметов в рюкзаке.
function add_gps_list( id, ot )
  if not ( id and alife():object( id ) ) then return end
  local hl = "habar_location"
  if map_has(id, hl) then
	level.map_remove_object_spot( id, hl )
  end
  local all_tbl = {}
  local flag = false
  local text = ""
  local red_string = ""
  local have_zamok = ""
  local items = ot or load_rukzak( id )
  local total = #items
  local total_items  = 0
  local total_weight = 0
  if total <= max_strings then
    red_string = "\\n"
  end
  for _, item in ipairs( items ) do
    local count  = item.count
    local cond   = item.condition
    local sect   = item.section
    local gtype  = item.game_type
    local name   = sect and translate( g_inv_name( sect ) )
    local weight = sect and get_float( sect, "inv_weight", 0 ) + get_art_box_weight( item )
    total_items  = total_items + count
    if gtype == "ammo" then
      total_weight = total_weight + ( weight * ( count / get_u32( sect, "box_size", 1 ) ) )
    else
      total_weight = total_weight + ( weight * count )
    end
    if sect == "zamok" then have_zamok = " %c[green](заперто на замок)" end
    table.insert( all_tbl, { sn = sect, inv = name, cnt = count, clr = get_color( sect, gtype ), cnd = cond, inf = item.info } )
    if sect == "amk_metka" then flag = true end
  end
  if flag == false then return end  -- проверить наличие метки?
  table.sort( all_tbl,
    function( a, b )
      if a.clr == b.clr then
        return a.inv < b.inv
      else
        return a.clr > b.clr
      end
    end
  )
  for i, v in pairs( all_tbl ) do
    local name  = v.inv and dsh.strip_quotes( v.inv )  -- убрать кавычки в начале и в конце строки
    name = correct_name( name )
    if string.find( v.sn, "arc_art_box_", 1, true ) then
      local arts = arc_ui_8container_menu.decode_custom_data( v.inf, v.sn )
      local nms = {}
      for _, t in ipairs( arts ) do
        local sect = t.section
        if sect then
          local t = nms[ sect ]
          nms[ sect ] = ( t and t + 1 ) or 1
        end
      end
      local cn = ""
      for k1, v1 in pairs( nms ) do
        cn = cn .. string.format( "%s(%d), ", dsh.strip_quotes( gt_inv_name( k1 ) ), v1 )
      end
      if cn ~= "" then name = string.format( "%s[%s]", name, string.sub( cn, 1, -3 ) ) end
    end
    if name then text = text .. v.clr .. name .. get_format_count( v.cnt, v.cnd ) .. red_string end
  end
  if total == 0 then
    text = "%c[255,0,191,255]Мой рюкзак" .. text .. "\\n%c[red]Пустой"
  else
    text = text .. "\\n%c[255,0,191,255]Всего: " .. string.format( "%s (%s)", total, total_items )
  end
  if total_weight > 0 then
    text = text .. string.format( ", общий вес: ~ %.1f кг.", total_weight )
  end
  map_adds( id, hl, text .. have_zamok )
end


function get_color( s, it )
  if not s then return "%c[default]" end
  if it == "weapon" or it == "knife" then -- оружие
    return "%c[254,243,122,11]"
  elseif it == "ammo" then -- патроны
    return "%c[254,129,129,11]"
  elseif it == "grenade" or it == "missile" then -- гранаты
    return "%c[208,100,100,255]"
  elseif it == "outfit" then -- броня
    return "%c[100,200,200,1]"
  elseif it == "scope" or it == "silencer" or it == "gl" then -- обвесы на оружие
    return "%c[0,128,64,1]"
  elseif it == "medkit" or it == "antirad" then -- медицина
    return "%c[128,128,192,1]"
  elseif it == "artefact" then -- артефакты
    return "%c[207,255,085,085]"
  elseif it == "food" then -- еда
    return "%c[254,255,218,185]"
  elseif string.find( s, "mutant_", 1, true ) or get_bool( s, "monster_part", false ) or ( it == "mutant_part" ) then -- части мутантов
    return "%c[50,1,150,1]"
  else
    return "%c[default]"
  end
end


local function trim( s )
  return ( string.gsub( s, "^%s*(.-)%s*$", "%1" ) )
end


function correct_name( s )
  if s then
    if string.find( s, "Патроны" ) then
      return trim( string.gsub( s, "Патроны", "П:" ) )
    elseif string.find( s, "Комбинезон" ) then
      return trim( string.gsub( s, "Комбинезон", "Комб" ) )
    elseif string.find( s, "Водка «Буратино»" ) then
      return "Водка"
    elseif string.find( s, "Противорадиационные препараты" ) or string.find( s, "Антирадиационные препараты" ) then
      return "Антирад"
    elseif string.find( s, "Радость туриста" ) then
      return "Консерва"
    elseif string.find( s, "Колбаса" ) then
      return "Колбаса"
    elseif string.find( s, "Энергетический" ) or string.find( s, "Энергетик" ) then
      return "Энергетик"
    end
  else
    return ""
  end
  return s
end


function get_format_count( c, cd )
  if cd and cd < 100 then  -- если состояние меньше 100%, оставим только состояние
    -- return "(" .. cd .. "%), "
    return "(" .. math.floor( tonumber( cd ) ) .. "%), "
  else
    if c and c > 1 then
      return "(" .. c .. "), "
    else
      return ", "
    end
  end
end


function on_inv_box_found( id, who )
  local boxs = alife():object( id )
  if not boxs then return end
  if boxs:section_name() ~= "dsh_treasure_item" then return end
  local items   = load_rukzak( id )
  local changed = false
  local allow_sms = false
  local lname     = who.level_name
  log3( "[%s]: on_inv_box_found trying: boxs: [%s], who: [%s], level: [%s]", script_name(), boxs:name(), who:name(), lname )
  for _, item in ipairs( items ) do
    if item.section == "zamok" then return false end
    if item.section == "amk_metka" then allow_sms = true end
  end
  for _, item in ipairs( items ) do
    if is_item_valuable( item ) and math.random() < 0.5 then
      local count = item.count
      local box_size
      if item.game_type == "ammo" then
        box_size = get_u32( item.section, "box_size" )
      end
      while count > 0 do
        local sobj
        if item.game_type == "ammo" then
          if count > box_size then
            sobj  = spawn_ammo_in_inv( item.section, box_size, who )
            count = count - box_size
          else
            sobj  = spawn_ammo_in_inv( item.section, count,    who )
            count = 0
          end
        else
          if item.game_type == "weapon" then
            sobj = spawn_weapon_in_inv( item.section, item.info, who )
          else
            sobj = spawn_item_in_inv( item.section, who )
          end
          count = count - 1
        end
        if item.condition < 100 then
          local iitem = sobj:get_inventory_item()
          iitem.item_condition = item.condition / 100
        end
		--[[
        if not amk_offline_alife.items[ who.id ] then
          amk_offline_alife.items[ who.id ] = {}
        end
        table.insert(
          amk_offline_alife.items[ who.id ], {
            id    = sobj.id,
            lname = lname,
            name  = sobj:name(),
          }
        )
		]]
      end
      item.count = 0
      changed = true
    end
  end
  if changed then
    save_rukzak( id, items )
    log3( "[%s]: The backpack [%s] was hacked by [%s] on level [%s]", script_name(), boxs:name(), who:name(), lname )
    op2.mylog( "[%s]: The backpack [%s] was hacked by [%s] on level [%s]", script_name(), boxs:name(), who:name(), lname )
    if db.actor and allow_sms then
      db.actor:give_game_news( "%c[255,160,160,160]" .. translate( "st_tip" ) .. "\\n"
        .. "%c[red]ВНИМАНИЕ!\\n%c[default]Один из тайников на локации %c[255,255,127,80]"
        .. dsh.remove_quotes( translate( boxs.level_name ) ) .. "%c[default] был кем-то вскрыт!", "ui\\ui_iconsTotal", Frect():set( 0, 846, 83, 47 ), 0, 60000
      )
      voice( [[device\pda\pda_sos]] ):play( db.actor, 0, sound_object.s2d )
    end
  end
  add_gps_list( id )
  return changed
end


-- Manool: добавлено вырождение артов в безлаговых рюкзаках. Затрагиваются все арты, которые передадутся в таблице arts.
-- Кратко: рандомно вырождается артефакт, затем булыжник может: 1. появится, 2. исчезнуть, 3. их количество не изменится.
-- TODO: желательно потестить, может чего напутал.
function blowout_modif_arts()
  local arts = amk_mod.arts
  for k, _ in pairs( ogse_unist.get_all_vars() ) do
    local id = string.match( k, "^dsh_rukzak%.([^.]+)%.sections$" )
    if id then
      local sobj = ai:object( tonumber( id ) )
      if sobj and isIndoor( sobj.level_name ) then goto SKIP end -- В подземках не трогать
      local items = load_rukzak( id, true )
      local index = {}
      local modif = 0
      local have_bul
      for i, item in ipairs( items ) do
        local sect = item.section
        if arts[ sect ] then
          local cnt  = item.count
          item.count = math.random( 0, cnt )
          modif = cnt - item.count
          if sect == "af_buliz" then
            index[ i ] = item
            have_bul   = true
          end
          -- log3(
            -- "[%s.blowout_modif_arts]: level: [%s], art: [%s], modif: [%s], have_bul: %s",
            -- script_name(), sobj.level_name, sect, modif, tostring( have_bul )
          -- )
        end
      end
      if modif < 1 then goto SKIP end
      local rnd = math.random( modif )
      if have_bul then
        for i, _ in pairs( index ) do
          while rnd > 0 do
            items[ i ].count = items[ i ].count + math.random( -1, 1 )
            rnd = rnd - 1
          end
        end
      else
        table.insert( items,
          {
            [ "section"   ] = "af_buliz",
            [ "condition" ] = 100,
            [ "game_type" ] = "artefact",
            [ "count"     ] = rnd,
            [ "info"      ] = "",
            [ "key"       ] = "af_buliz:100.00:"
          }
        )
      end
      save_rukzak( id, items, true )
      ::SKIP::
    end
  end
end


local tid
function body_open()
  tid = level.get_target_obj()
  if tid then
    tid = tid:id()
  end
end


function body_close()
  local box = level.object_by_id( tid )
  if not ( box and box:is_inventory_box() ) then
    tid = nil
    return
  end
  if not box:object_from_inv_box( "amk_metka" ) then
    if map_has( box:id(), "habar_location" ) then
      map_rem( box:id(), "habar_location" )
    end
    tid = nil
    return
  end
  local items_our = {}
  local by_key = {}
  for i = 0, box:inv_box_count() - 1 do
    local obj = box:object_from_inv_box( i )
    if ai:object( obj:id() ) and ( not db.actor:marked_dropped( obj ) ) then
      local sect = obj:section()
      local cond = string.format( "%.2f", obj:condition() * 100 )
      local info = get_item_info( obj )
      local key  = sect .. ":" .. cond .. ":" .. info
      local item = by_key[ key ]
      if item then
        table.insert( by_key[ key ].game_objs, obj )
      else
        item = {
          [ "section"   ] = sect,
          [ "condition" ] = tonumber( cond ),
          [ "game_objs" ] = { obj },
          [ "game_type" ] = get_game_type( obj ),
          [ "info"      ] = info,
          [ "key"       ] = key
        }
        by_key[ key ] = item
        table.insert( items_our, item )
      end
      if item.game_type == "ammo" then
        if item.count then
          item.count = item.count + obj:get_current_ammo()
        else
          item.count = obj:get_current_ammo()
        end
      else
        if item.count then
          item.count = item.count + 1
        else
          item.count = 1
        end
      end
    end
  end
  add_gps_list( tid, items_our )
  tid, items_our, by_key = nil, nil, nil
end
