local function on_info(npc, info_id)
    if level.name() == "l05_bar" then
        if info_id == "bar_narod_spawn" then

            local obj = alife():object("bar_bar_visitor_hunter")
            if obj then
                alife():release(obj, true)
            end
            log3("delete govno bar")
        end
    end
end

function attach( sm )
    -- sm:subscribe({ signal = "on_before_first_update", fun = this.on_first_update })
    -- sm:subscribe({ signal = "on_before_spawn", fun = this.on_spawn })
    sm:subscribe({ signal = "on_info",         fun = on_info})
end

