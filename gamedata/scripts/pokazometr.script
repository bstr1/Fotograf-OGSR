-- 4etkiu
function log(s)
    if s then
        -- Пишет напрямую в лог без мусора в консоли и фризов
        _G.log1("---POKAZOMETR: " .. tostring(s))
    end
end

local show_pos_enable = false -- отображение динамических сообщений
function enable(v) -- вызывать pokazometr.enable( true ) из net_spawn() актора
    if v then
        show_pos_enable = true -- и pokazometr.enable( false ) из net_destroy() актора
    else -- иначе - вылеты при повторной загрузке.
        show_pos_enable = false -- к сожалению, возможность сделать скрипт, не требующий
        this.show_pos_stop() -- изменения в других файлах, дружными усилиями сообщества
    end -- мУдоделов заблокирована наглухо.
end

